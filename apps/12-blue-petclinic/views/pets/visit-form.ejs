<%- await include('../partials/head.ejs', { title: await t('visit.form.new') }) %>
<h1><%= await t('visit.form.new') %></h1>
<p class="lead">
    <a href="/owners/<%= owner.id %>"><%= owner.firstName %> <%= owner.lastName %></a>
    — <%= detail.pet.name %>
    <span class="muted">(<%= detail.type === undefined ? '' : detail.type.name %>)</span>
</p>

<% if (Object.keys(errors).length > 0) { %>
<p class="alert" role="alert"><%= await t('form.errors') %></p>
<% } %>

<form class="form" method="post" action="<%= action %>" novalidate>
    <div class="field<%= errors.visitDate ? ' field-error' : '' %>">
        <label for="visitDate"><%= await t('visit.date') %></label>
        <input id="visitDate" name="visitDate" type="date" value="<%= values.visitDate %>" required />
        <% if (errors.visitDate) { %><span class="error"><%= await t(errors.visitDate.key) %></span><% } %>
    </div>

    <div class="field<%= errors.description ? ' field-error' : '' %>">
        <label for="description"><%= await t('visit.description') %></label>
        <input id="description" name="description" type="text" value="<%= values.description %>" required />
        <% if (errors.description) { %><span class="error"><%= await t(errors.description.key) %></span><% } %>
    </div>

    <p class="actions">
        <button type="submit"><%= await t('visit.add') %></button>
        <a class="link" href="/owners/<%= owner.id %>"><%= await t('form.cancel') %></a>
    </p>
</form>

<%- await include('../partials/footer.ejs') %>
