{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@ndigo/redis/cache": ["./packages/ndigo-redis/src/cache"],
      "@ndigo/redis/pubsub": ["./packages/ndigo-redis/src/pubsub"],
      "@ndigo/*": ["./packages/ndigo-*/src"]
    }
  },
  "include": ["packages/*/src/**/*", "apps/*/src/**/*"],
  "exclude": ["**/node_modules/**/*", "**/*.spec.ts", "**/*.test.ts"]
}
