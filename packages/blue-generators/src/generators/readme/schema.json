{
    "$schema": "https://json-schema.org/schema",
    "id": "BlueReadme",
    "title": "Create a BlueJS Package README",
    "type": "object",
    "properties": {
        "name": {
            "type": "string",
            "description": "The package name (kebab-case, without 'blue-' prefix)",
            "x-prompt": "What is the package name? (e.g., 'telemetry-otel')"
        },
        "description": {
            "type": "string",
            "description": "Short one-line description used in the intro",
            "default": ""
        },
        "path": {
            "type": "string",
            "description": "Destination directory for the README (defaults to packages/blue-<name>)"
        }
    },
    "required": ["name"]
}
