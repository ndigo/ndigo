import 'node:process';
import { ApplicationBuilder } from '@ndigo/boot';
import { getEnv } from '@ndigo/context';
import { NodeAutoConfiguration, HTTP_SERVER, gracefulShutdown } from '@ndigo/platform-node';
import { getLogger } from '@ndigo/log';
import { getErrorMessage } from '@ndigo/util';
import { <%= className %>Configuration } from './<%= name %>-configuration';

// The managed server reads `process.env.PORT` when no explicit port is
// passed, so surface the app's default before the context is built —
// otherwise `pnpm start` and the logged URL would disagree.
process.env['PORT'] ??= '<%= port %>';
const PORT = Number(getEnv('PORT', '<%= port %>'));
const logger = getLogger('<%= name %>');

async function main() {
    // DI-container bootstrap: register platform auto-config + app config,
    // then run() prepares the environment and refreshes the context.
    const context = await new ApplicationBuilder([NodeAutoConfiguration, <%= className %>Configuration]).run();

    // Managed HTTP server: resolve it from the context and await its start
    // so "listening" fires once the socket is bound. The context stops it
    // on close.
    const server = context.getValue(HTTP_SERVER);
    await server.start();
    gracefulShutdown(context, { resources: [server] });

    logger.info(`listening on http://127.0.0.1:${PORT}`);
}

main().catch((err) => {
    logger.error(`failed to start: ${getErrorMessage(err)}`);
    process.exit(1);
});
