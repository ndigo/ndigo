{
  "name": "@ndigo/telemetry",
  "version": "0.0.1",
  "description": "Isomorphic telemetry core for Ndigo — API-only: logger, metrics, severity, tracing decorators",
  "keywords": [
    "ndigo",
    "ndigo",
    "ndigo-js",
    "ndigo-telemetry",
    "observability",
    "opentelemetry",
    "metrics",
    "tracing"
  ],
  "type": "module",
  "files": [
    "api",
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "types": "lib/index.d.ts",
  "scripts": {
    "build:lib": "tsc -b tsconfig.build.json",
    "test": "vitest run --config ../../vitest.config.ts",
    "test:watch": "vitest --config ../../vitest.config.ts"
  },
  "author": "Jeff Rose <jeff_rose@outlook.com>",
  "license": "ISC",
  "dependencies": {
    "@ndigo/context": "~0.0.1",
    "@ndigo/locks": "~0.0.1",
    "@ndigo/resilience": "~0.0.1",
    "@ndigo/rate-limit": "~0.0.1",
    "@ndigo/cache": "~0.0.1",
    "@ndigo/core": "~0.0.1",
    "@ndigo/dispatcher": "~0.0.1",
    "@ndigo/host": "~0.0.1",
    "@ndigo/http": "~0.0.1",
    "@ndigo/log": "~0.0.1",
    "@ndigo/router": "~0.0.1",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/instrumentation": "catalog:",
    "@tsmetadata/polyfill": "catalog:"
  },
  "devDependencies": {},
  "sideEffects": false
}
