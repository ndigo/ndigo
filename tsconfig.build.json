{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "inlineSourceMap": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "skipLibCheck": true
  },
  "exclude": ["**/*.spec.ts", "**/*.test.ts", "**/test/**", "**/tests/**", "vite.config.ts", "vitest.config.ts"]
}
