{
  "name": "@blue/js",
  "private": true,
  "version": "0.0.1",
  "description": "The BlueJS framework",
  "type": "module",
  "scripts": {
    "build": "nx run-many -t build:lib",
    "build:all": "pnpm --filter @blue/todomvc build && pnpm --filter todomvc-svelte build && pnpm --filter todomvc-vue build && pnpm --filter todomvc-react build && pnpm --filter todomvc-javascript-es6-webpack build",
    "test:benchmark": "node scripts/benchmark-preview.mjs",
    "test:benchmark:react": "pnpm exec tsx scripts/benchmark-dom.ts --impl react",
    "test:benchmark:svelte": "pnpm exec tsx scripts/benchmark-dom.ts --impl svelte",
    "test:benchmark:vue": "pnpm exec tsx scripts/benchmark-dom.ts --impl vue",
    "test:benchmark:vanilla": "pnpm exec tsx scripts/benchmark-dom.ts --impl vanilla",
    "build:bluejs": "pnpm --filter ../todomvc/examples/bluejs run build",
    "build:todomvc": "pnpm --filter @blue/todomvc run build",
    "test": "nx run-many -t test",
    "test:bench": "vitest bench --run --reporter verbose",
    "test:e2e": "nx run @blue/todo:test:e2e",
    "typecheck": "pnpm --filter './packages/**' --filter './apps/**' -r exec tsc -b tsconfig.build.json",
    "lint": "pnpm --filter @blue/oxlint-plugin build:lib && oxlint --type-aware --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "doc": "pnpm doc:api",
    "doc:api": "node scripts/doc-api.mjs",
    "doc:check": "pnpm doc:api && git diff --exit-code -- packages doc",
    "docs:links": "node scripts/check-doc-links.mjs",
    "manifest:check": "node scripts/check-manifests.mjs",
    "graft:build": "graft build --deep --allow-partial",
    "postinstall": "node scripts/typedoc-ts-shim.mjs",
    "agents:sync": "node ../development-agents/gen.mjs .",
    "agents:check": "node scripts/agents-check.mjs"
  },
  "keywords": [
    "blue",
    "bluejs",
    "blue-js",
    "framework"
  ],
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.4.0",
  "author": "Jeff Rose <jeff_rose@outlook.com>",
  "license": "ISC",
  "devDependencies": {
    "@nx/devkit": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@tsmetadata/polyfill": "catalog:",
    "@types/node": "catalog:",
    "jsdom": "~30.1.0",
    "msw": "~2.15.0",
    "nx": "catalog:",
    "oxfmt": "^0.70.0",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "^7.0.2003",
    "safe-regex": "catalog:",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "tsx": "catalog:"
  }
}
