{
  "ignorePatterns": [
    "archive",
    "coverage",
    "lib",
    "dist",
    "node_modules",
    "index.js",
    "**/lib/**",
    "**/dist/**",
    "**/tmp/**",
    "**/.tmp/**",
    "**/*.min.js",
    "**/*.legacy.js",
    "**/coverage/**",
    "**/node_modules/**",
    "**/test/**/*.js",
    "apps/blue-todo/index.js",
    "*.config.js",
    "*.config.mjs",
    "*.config.ts"
  ],
  "jsPlugins": ["./packages/blue-oxlint-plugin/lib/index.js"],
  "rules": {
    "no-unused-vars": "off",
    "no-undef": "off",
    "@typescript-eslint/adjacent-overload-signatures": "error",
    "@typescript-eslint/explicit-function-return-type": "off",
    "@typescript-eslint/explicit-member-accessibility": "off",
    "@typescript-eslint/no-array-constructor": "error",
    "@typescript-eslint/no-empty-interface": "off",
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/no-inferrable-types": "off",
    "@typescript-eslint/no-namespace": [
      "error",
      {
        "allowDeclarations": false,
        "allowDefinitionFiles": false
      }
    ],
    "@typescript-eslint/no-non-null-assertion": "error",
    "@typescript-eslint/triple-slash-reference": "off",
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "vars": "local",
        "args": "none",
        "caughtErrors": "none",
        "varsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "@typescript-eslint/no-use-before-define": [
      "error",
      {
        "classes": false,
        "functions": false,
        "typedefs": false,
        "variables": false
      }
    ],
    "@typescript-eslint/no-require-imports": "off",
    "@typescript-eslint/prefer-namespace-keyword": "error",
    "@blue/no-direct-integration-imports": "warn",
    "@blue/no-internal-file-imports": "error",
    "@blue/no-internal-file-exports": "error",
    "@blue/no-browser-globals-in-isomorphic": "warn",
    "@blue/no-uppercase-regexp-constants": "error",
    "@blue/no-abstract-class-without-prefix": "error",
    "@blue/no-mixed-case-acronyms": "error",
    "@blue/no-cross-paradigm-decorators": "error",
    "@blue/no-scheduled-in-browser": "error",
    "@blue/no-signals-in-entity": "error",
    "@blue/no-string-registry-lookup": "error",
    "@blue/no-unsafe-view-name-literal": "error",
    "@blue/no-duplicate-mapping-path": "error",
    "no-shadow": "warn",
    "no-useless-escape": "warn",
    "no-unsafe-optional-chaining": "warn",
    "no-sparse-arrays": "warn",
    "no-unneeded-ternary": "warn",
    "no-extra-boolean-cast": "warn",
    "no-unused-private-class-members": "warn",
    "no-this-alias": "warn",
    "no-instanceof-builtins": "off",
    "prefer-set-size": "warn",
    "require-module-specifiers": "warn",
    "preserve-caught-error": "warn",
    "no-await-in-loop": "warn",
    "no-new-array": "off",
    "no-thenable": "off",
    "typescript/no-base-to-string": "off",
    "typescript/restrict-template-expressions": "off",
    "typescript/unbound-method": "off",
    "typescript/no-redundant-type-constituents": "off",
    "typescript/no-implied-eval": "off",
    "@blue/requires-doc-header": "error",
    "@blue/no-raw-console": "error"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2022": true
  },
  "globals": {
    "process": "readonly",
    "Buffer": "readonly",
    "afterAll": "readonly",
    "afterEach": "readonly",
    "beforeAll": "readonly",
    "beforeEach": "readonly",
    "describe": "readonly",
    "it": "readonly",
    "expect": "readonly",
    "test": "readonly",
    "vi": "readonly"
  },
  "overrides": [
    {
      "files": ["**/*.spec.ts", "**/*.test.ts", "**/test/**/*.ts", "**/test/**/*.js", "**/test/**/*.mjs"],
      "rules": {
        "@typescript-eslint/no-unused-vars": "off",
        "no-shadow": "off",
        "no-useless-escape": "off",
        "no-instanceof-builtins": "off",
        "@blue/no-duplicate-mapping-path": "off",
        "@blue/no-raw-console": "off"
      }
    },
    {
      "files": ["apps/**/*.ts", "apps/**/*.js", "apps/**/*.mjs"],
      "rules": {
        "@blue/no-browser-globals-in-isomorphic": "off"
      }
    }
  ]
}
