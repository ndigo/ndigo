<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
    <meta charset="utf-8" />
    <title><%= await t('app.title') %></title>
    <!-- The design tokens and base layer are build inputs of the client bundle;
         the static controller serves the built asset. Custom properties inherit
         into the island's shadow root, so the page and island share one theme. -->
    <link rel="stylesheet" href="/static/client.css" />
    <style>
        body { font-family: var(--nd-font-sans, system-ui, sans-serif); max-width: 40rem; margin: 3rem auto; padding: 0 1rem; }
        todo-app { display: block; padding: 1rem; background: var(--nd-color-surface, #fff); border: 1px solid var(--nd-color-border, #ddd); border-radius: var(--nd-radius-lg, 8px); }
    </style>
</head>
<body>
    <h1><%= await t('app.title') %></h1>
    <p><%- await t('app.intro') %></p>
    <p><%= await t('app.today', { values: { date: formatDate(today, { dateStyle: 'long', timeZone: 'UTC' }) } }) %></p>
    <p><%= await t('app.mode.switched', { values: { language: locale.toUpperCase() } }) %></p>
    <!-- Island markup is rendered server-side by `IslandView` (with a
         declarative shadow root for first paint) and interpolated raw. The
         renderer runs now so it sees the request's negotiated language. -->
    <%- await renderIslandHtml() %>
    <script type="module" src="/static/client.js"></script>
</body>
</html>