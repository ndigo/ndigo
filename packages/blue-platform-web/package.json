{
  "name": "@blue/platform-web",
  "version": "0.0.1",
  "description": "Browser platform adapter for BlueJS — dispatcher glue, history/cookie resolvers, themes",
  "type": "module",
  "files": [
    "doc",
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./browser-dispatcher": {
      "types": "./lib/browser-dispatcher.d.ts",
      "default": "./lib/browser-dispatcher.js"
    },
    "./web-auto-configuration": {
      "types": "./lib/web-auto-configuration.d.ts",
      "default": "./lib/web-auto-configuration.js"
    },
    "./browser-theme": {
      "types": "./lib/browser-theme.d.ts",
      "default": "./lib/browser-theme.js"
    }
  },
  "types": "lib/index.d.ts",
  "scripts": {
    "build:lib": "tsc -b tsconfig.build.json",
    "test": "vitest run"
  },
  "keywords": [
    "blue",
    "bluejs",
    "blue-js",
    "blue-platform",
    "blue-platform-web",
    "platform",
    "web"
  ],
  "author": "Jeff Rose <jeff_rose@outlook.com>",
  "license": "ISC",
  "devDependencies": {
    "zod": "catalog:"
  },
  "dependencies": {
    "@blue/content": "~0.0.1",
    "@blue/context": "~0.0.1",
    "@blue/core": "~0.0.1",
    "@blue/dispatcher": "~0.0.1",
    "@blue/http": "~0.0.1",
    "@blue/router": "~0.0.1",
    "@blue/signals": "~0.0.1",
    "@blue/socket": "~0.0.1",
    "@blue/util": "~0.0.1",
    "@blue/view": "~0.0.1",
    "@blue/view-webcomponent": "~0.0.1"
  },
  "sideEffects": false
}
