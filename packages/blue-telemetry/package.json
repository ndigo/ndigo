{
  "name": "@blue/telemetry",
  "version": "0.0.1",
  "description": "Isomorphic telemetry core for BlueJS — API-only: logger, metrics, severity, tracing decorators",
  "keywords": [
    "blue",
    "bluejs",
    "blue-js",
    "blue-telemetry",
    "observability",
    "opentelemetry",
    "metrics",
    "tracing"
  ],
  "type": "module",
  "files": [
    "api",
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "types": "lib/index.d.ts",
  "scripts": {
    "build:lib": "tsc -b tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "Jeff Rose <jeff_rose@outlook.com>",
  "license": "ISC",
  "dependencies": {
    "@blue/context": "~0.0.1",
    "@blue/core": "~0.0.1",
    "@blue/dispatcher": "~0.0.1",
    "@blue/log": "~0.0.1",
    "@blue/router": "~0.0.1",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/instrumentation": "catalog:",
    "@tsmetadata/polyfill": "catalog:"
  },
  "devDependencies": {},
  "sideEffects": false
}
