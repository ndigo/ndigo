.awcache
.DS_Store
.nyc_output
.scratch/
.vscode
archive
coverage
lerna-debug.log
node_modules
npm-debug.log
tmp
tsconfig.tsbuildinfo
yarn-error.log

# TypeScript build output
**/src/**/*.js
**/src/**/*.js.map
**/src/**/*.d.ts.map
**/src/**/*.d.ts
# Hand-authored type declarations (not generated) — must not be ignored
!packages/ndigo-util/src/_types/*.d.ts
!packages/ndigo-util/src/_safe-regex.d.ts
# Hand-authored Vite ambient types for the UI lab.
!apps/20-ndigo-ui-lab/src/vite-env.d.ts
# TypeScript development cache
**/.tscache/
# Note: .d.ts files in src/ are generated build artifacts (mirrors of .ts sources).
# If an intentional hand-authored .d.ts is needed, stage it with `git add -f`.
**/test/**/*.js
**/test/**/*.d.ts.map
**/test/**/*.d.ts
**/lib/
# Hand-authored application sources under `src/lib/` (the blanket `**/lib/`
# above would swallow them): re-included so a fresh checkout can build the
# client. `git check-ignore` must stay silent for these.
!apps/10-ndigo-conduit-web/src/lib/
!apps/10-ndigo-conduit-web/src/lib/**
# Registry copy-in foundation for the UI lab (the `lib` item targets @lib/).
!apps/20-ndigo-ui-lab/src/lib/
!apps/20-ndigo-ui-lab/src/lib/**
*.tsbuildinfo

# Build artifacts in package roots
vite.config.js
vite.config.d.ts
vite.config.js.map
vite.config.d.ts.map

# Nx cache
.nx/cache
.nx/workspace-data

# API Extractor temp files
**/temp/

# Tarball artifacts
*.tgz

# pnpm
.pnpm-debug.log

# Vitest
.vitest
# Generated vitest config artifacts (the .ts source is maintained)
vitest.config.js
vitest.config.d.ts
vitest.config.d.ts.map

# App build output (Vite bundles). Committed source only — dist/ and the
# root index.js bundle are generated per build.
apps/*/dist/
apps/*/index.js
apps/*/index.js.map
/index.js
/index.js.map

# Application runtime databases (AD-78: file-backed Drizzle store created by
# the migrations; committed migrations/snapshots live under apps/*/db/)
apps/*/data/

# Documentation
docs-ts/
playwright-report/
test-results/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# opencode plugin dependencies (installed on demand by opencode)
.opencode/node_modules/
