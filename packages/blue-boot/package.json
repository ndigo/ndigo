{
  "name": "@blue/boot",
  "version": "0.0.1",
  "description": "Application bootstrap, profiles, and typed configuration for BlueJS",
  "keywords": [
    "blue",
    "bluejs",
    "blue-js",
    "blue-app",
    "blue-boot",
    "app",
    "boot"
  ],
  "type": "module",
  "files": [
    "api",
    "lib",
    "schema"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js",
      "types": "./lib/index.d.ts"
    },
    "./schema/application.schema.json": "./schema/application.schema.json"
  },
  "types": "lib/index.d.ts",
  "scripts": {
    "build:lib": "tsc -b tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "Jeff Rose <jeff_rose@outlook.com>",
  "license": "ISC",
  "devDependencies": {
    "@blue/dispatcher": "~0.0.1",
    "@blue/platform-node": "~0.0.1",
    "@blue/platform-web": "~0.0.1",
    "@blue/telemetry-node": "~0.0.1",
    "@toon-format/toon": "catalog:"
  },
  "sideEffects": false,
  "peerDependencies": {
    "@toon-format/toon": "4.4.0"
  },
  "peerDependenciesMeta": {
    "@toon-format/toon": {
      "optional": true
    }
  },
  "dependencies": {
    "@blue/context": "~0.0.1",
    "@blue/core": "~0.0.1",
    "@blue/factory": "~0.0.1",
    "@blue/log": "~0.0.1",
    "@blue/router": "~0.0.1",
    "@blue/util": "~0.0.1",
    "zod": "catalog:"
  }
}
