{
  "tabWidth": 4,
  "useTabs": false,
  "endOfLine": "lf",
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "printWidth": 120,
  "arrowParens": "always",
  "bracketSpacing": true,
  "jsxSingleQuote": false,
  "sortPackageJson": false,
  "proseWrap": "preserve",
  "ignorePatterns": [
    "/api/",
    "/API.md",
    "packages/*/api/",
    "packages/ndigo-cli/assets/agent/docs-index.md",
    "tools/agent-content/docs-index.md",
    "**/graft/",
    "lib/",
    "dist/",
    "coverage/",
    "*.map",
    "*.tsbuildinfo",
    ".nx/",
    ".cache/",
    ".vitest/",
    "*.log",
    ".scratch/",
    ".ideas/",
    ".examples/",
    "scratch/",
    "archive/",
    "pnpm-lock.yaml",
    "yarn.lock",
    "package-lock.json",
    "node_modules/",
    ".pnpm-store/",
    ".mcp.json",
    ".opencode/",
    ".omp/",
    ".claude/",
    ".review-notes.md",
    "index.js",
    "index.cjs",
    "src/index.js",
    "AGENTS.md",
    ".github/copilot-instructions.md",
    "opencode.json"
  ],
  "overrides": [
    {
      "files": ["*.json", "*.yaml", "*.yml"],
      "options": {
        "tabWidth": 2
      }
    }
  ]
}
