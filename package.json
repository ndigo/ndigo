{
  "name": "@blue/js",
  "private": true,
  "version": "0.0.1",
  "description": "The BlueJS framework",
  "type": "module",
  "files": [
    "doc",
    "lib"
  ],
  "exports": "./lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "nx run-many -t build:lib",
    "build:all": "pnpm --filter @blue/todomvc build && pnpm --filter todomvc-svelte build && pnpm --filter todomvc-vue build && pnpm --filter todomvc-react build && pnpm --filter todomvc-javascript-es6-webpack build",
    "test:benchmark": "pnpm --filter @blue/todomvc run preview & sleep 5 && pnpm exec node --experimental-specifier-resolution=node --import ./node_modules/.pnpm/tsx@4.22.3/node_modules/tsx/dist/esm/index.mjs ../todomvc/examples/bluejs/benchmark-runner.ts",
    "test:benchmark:react": "pnpm exec node --experimental-specifier-resolution=node --import ./node_modules/.pnpm/tsx@4.22.3/node_modules/tsx/dist/esm/index.mjs benchmark-react.ts",
    "test:benchmark:svelte": "pnpm exec node --experimental-specifier-resolution=node --import ./node_modules/.pnpm/tsx@4.22.3/node_modules/tsx/dist/esm/index.mjs benchmark-svelte.ts",
    "test:benchmark:vue": "pnpm exec node --experimental-specifier-resolution=node --import ./node_modules/.pnpm/tsx@4.22.3/node_modules/tsx/dist/esm/index.mjs benchmark-vue.ts",
    "test:benchmark:vanilla": "pnpm exec node --experimental-specifier-resolution=node --import ./node_modules/.pnpm/tsx@4.22.3/node_modules/tsx/dist/esm/index.mjs benchmark-vanilla.ts",
    "build:bluejs": "pnpm --filter ../todomcv/examples/bluejs run build",
    "build:todomvc": "nx run @blue/todomvc:build:lib",
    "test": "nx run-many -t test",
    "test:bench": "vitest bench --run --reporter verbose",
    "test:e2e": "nx run @blue/todo:test:e2e",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doc": "pnpm doc:md",
    "doc:md": "typedoc",
    "doc:html": "typedoc --options typedoc.html.json",
    "doc:json": "typedoc --json doc-md/api.json",
    "doc:watch": "typedoc --watch",
    "lint:ast-grep": "ast-grep scan",
    "label-graph": "node label_injector.js",
    "label-labels": "node label_writer.js",
    "manifest:check": "node scripts/check-manifests.mjs",
    "graft:build": "graft build --deep --allow-partial"
  },
  "keywords": [
    "blue",
    "bluejs",
    "blue-js",
    "framework"
  ],
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.4.0",
  "author": "Jeff Rose <jeff_rose@outlook.com>",
  "license": "ISC",
  "devDependencies": {
    "@ast-grep/cli": "~0.45.3",
    "@nx/devkit": "~23.2.0",
    "@oxlint/plugins": "^1.81.0",
    "@tsmetadata/polyfill": "^1.1.3",
    "@types/node": "~24.13.2",
    "@vitejs/plugin-basic-ssl": "~2.3.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "~4.0.18",
    "benchmark": "~2.1.4",
    "cross-env": "~10.1.0",
    "debug": "~4.4.3",
    "glob": "^13.0.6",
    "jsdom": "~30.0.1",
    "msw": "~2.15.0",
    "nx": "~23.2.0",
    "oxlint": "^1.81.0",
    "prettier": "~3.9.6",
    "safe-regex": "^2.1.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "~6.0.3",
    "vitest": "~4.0.18"
  },
  "msw": {
    "workerDirectory": "test"
  }
}
