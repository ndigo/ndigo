    "@ndigo/jobs": "~0.0.1",
    "@ndigo/orm": "~0.0.1",
    "@ndigo/socket": "~0.0.1",
    "@ndigo/util": "~0.0.1",
    "@libsql/client": "0.18.0",
    "drizzle-orm": "0.45.4",
