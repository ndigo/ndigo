{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "inlineSourceMap": false,
    "sourceMap": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // The app-root `vitest.config.ts` files import the shared alias table from
    // the repo root (`../../vitest.aliases`), so the common source directory is
    // the workspace root — declare it, mirroring the packages' tsconfig.json.
    "rootDir": ".."
  },
  "exclude": ["**/node_modules", "**/dist", "**/lib", "**/*.spec.ts"]
}
