{
  // Spec-typecheck lane (TST-A): typechecks every package/app source AND its
  // tests under the build chain's flags (it extends tsconfig.build.json, so the
  // IDE-only erasableSyntaxOnly rule is NOT enforced here and src/ stays green).
  // Paths mirror vitest.aliases.ts exactly (subpaths first); the wildcard siblings
  // map tsc's exact-match patterns onto the regex prefix aliases.
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    // The generators package and the repo-only `src/` tree import their own
    // modules with `.ts` specifiers (Node's native type stripping; AD-85 /
    // AD-86) — the noEmit lane here permits the extension without rewriting.
    "allowImportingTsExtensions": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node", "vitest/globals"],
    "paths": {
      "@ndigo/util/crypto": ["./packages/ndigo-util/src/crypto"],
      "@ndigo/util/crypto/*": ["./packages/ndigo-util/src/crypto/*"],
      "@ndigo/util/math": ["./packages/ndigo-util/src/math"],
      "@ndigo/util/math/*": ["./packages/ndigo-util/src/math/*"],
      "@ndigo/util/string": ["./packages/ndigo-util/src/string"],
      "@ndigo/util/string/*": ["./packages/ndigo-util/src/string/*"],
      "@ndigo/util/types": ["./packages/ndigo-util/src/type"],
      "@ndigo/util/types/*": ["./packages/ndigo-util/src/type/*"],
      "@ndigo/util/type": ["./packages/ndigo-util/src/type"],
      "@ndigo/util/type/*": ["./packages/ndigo-util/src/type/*"],
      "@ndigo/core": ["./packages/ndigo-core/src"],
      "@ndigo/core/*": ["./packages/ndigo-core/src/*"],
      "@ndigo/dom": ["./packages/ndigo-dom/src"],
      "@ndigo/dom/*": ["./packages/ndigo-dom/src/*"],
      "@ndigo/util": ["./packages/ndigo-util/src"],
      "@ndigo/util/*": ["./packages/ndigo-util/src/*"],
      "@ndigo/factory": ["./packages/ndigo-factory/src"],
      "@ndigo/factory/*": ["./packages/ndigo-factory/src/*"],
      "@ndigo/context": ["./packages/ndigo-context/src"],
      "@ndigo/context/*": ["./packages/ndigo-context/src/*"],
      "@ndigo/router": ["./packages/ndigo-router/src"],
      "@ndigo/router/*": ["./packages/ndigo-router/src/*"],
      "@ndigo/host": ["./packages/ndigo-host/src"],
      "@ndigo/host/*": ["./packages/ndigo-host/src/*"],
      "@ndigo/view": ["./packages/ndigo-view/src"],
      "@ndigo/view/*": ["./packages/ndigo-view/src/*"],
      "@ndigo/view-ejs": ["./packages/ndigo-view-ejs/src"],
      "@ndigo/view-ejs/*": ["./packages/ndigo-view-ejs/src/*"],
      "@ndigo/view-webcomponent": ["./packages/ndigo-view-webcomponent/src"],
      "@ndigo/view-webcomponent/*": ["./packages/ndigo-view-webcomponent/src/*"],
      "@ndigo/http": ["./packages/ndigo-http/src"],
      "@ndigo/http/*": ["./packages/ndigo-http/src/*"],
      "@ndigo/content": ["./packages/ndigo-content/src"],
      "@ndigo/content/*": ["./packages/ndigo-content/src/*"],
      "@ndigo/content-i18next": ["./packages/ndigo-content-i18next/src"],
      "@ndigo/content-i18next/*": ["./packages/ndigo-content-i18next/src/*"],
      "@ndigo/platform-web": ["./packages/ndigo-platform-web/src"],
      "@ndigo/platform-web/*": ["./packages/ndigo-platform-web/src/*"],
      "@ndigo/platform-node": ["./packages/ndigo-platform-node/src"],
      "@ndigo/platform-node/*": ["./packages/ndigo-platform-node/src/*"],
      "@ndigo/dispatcher": ["./packages/ndigo-dispatcher/src"],
      "@ndigo/dispatcher/*": ["./packages/ndigo-dispatcher/src/*"],
      "@ndigo/boot": ["./packages/ndigo-boot/src"],
      "@ndigo/boot/*": ["./packages/ndigo-boot/src/*"],
      "@ndigo/service": ["./packages/ndigo-service/src"],
      "@ndigo/service/*": ["./packages/ndigo-service/src/*"],
      "@ndigo/scheduler": ["./packages/ndigo-scheduler/src"],
      "@ndigo/scheduler/*": ["./packages/ndigo-scheduler/src/*"],
      "@ndigo/jobs": ["./packages/ndigo-jobs/src"],
      "@ndigo/jobs/*": ["./packages/ndigo-jobs/src/*"],
      "@ndigo/cache": ["./packages/ndigo-cache/src"],
      "@ndigo/cache/*": ["./packages/ndigo-cache/src/*"],
      "@ndigo/proxy": ["./packages/ndigo-proxy/src"],
      "@ndigo/proxy/*": ["./packages/ndigo-proxy/src/*"],
      "@ndigo/resilience": ["./packages/ndigo-resilience/src"],
      "@ndigo/resilience/*": ["./packages/ndigo-resilience/src/*"],
      "@ndigo/redis/cache": ["./packages/ndigo-redis/src/cache"],
      "@ndigo/redis/cache/*": ["./packages/ndigo-redis/src/cache/*"],
      "@ndigo/redis/pubsub": ["./packages/ndigo-redis/src/pubsub"],
      "@ndigo/redis/pubsub/*": ["./packages/ndigo-redis/src/pubsub/*"],
      "@ndigo/redis": ["./packages/ndigo-redis/src"],
      "@ndigo/redis/*": ["./packages/ndigo-redis/src/*"],
      "@ndigo/socket": ["./packages/ndigo-socket/src"],
      "@ndigo/socket/*": ["./packages/ndigo-socket/src/*"],
      "@ndigo/signals": ["./packages/ndigo-signals/src"],
      "@ndigo/signals/*": ["./packages/ndigo-signals/src/*"],
      "@ndigo/log": ["./packages/ndigo-log/src"],
      "@ndigo/log/*": ["./packages/ndigo-log/src/*"],
      "@ndigo/telemetry": ["./packages/ndigo-telemetry/src"],
      "@ndigo/telemetry/*": ["./packages/ndigo-telemetry/src/*"],
      "@ndigo/telemetry-node": ["./packages/ndigo-telemetry-node/src"],
      "@ndigo/telemetry-node/*": ["./packages/ndigo-telemetry-node/src/*"],
      "@ndigo/telemetry-web": ["./packages/ndigo-telemetry-web/src"],
      "@ndigo/telemetry-web/*": ["./packages/ndigo-telemetry-web/src/*"],
      "@ndigo/oxlint-plugin": ["./packages/ndigo-oxlint-plugin/src"],
      "@ndigo/oxlint-plugin/*": ["./packages/ndigo-oxlint-plugin/src/*"],
      "@ndigo/orm": ["./packages/ndigo-orm/src"],
      "@ndigo/orm/*": ["./packages/ndigo-orm/src/*"],
      "@ndigo/orm-drizzle": ["./packages/ndigo-orm-drizzle/src"],
      "@ndigo/orm-drizzle/*": ["./packages/ndigo-orm-drizzle/src/*"],
      "@ndigo/management": ["./packages/ndigo-management/src"],
      "@ndigo/management/*": ["./packages/ndigo-management/src/*"],
      "@ndigo/auth-core": ["./packages/ndigo-auth-core/src"],
      "@ndigo/auth-core/*": ["./packages/ndigo-auth-core/src/*"],
      "@ndigo/auth-server": ["./packages/ndigo-auth-server/src"],
      "@ndigo/auth-server/*": ["./packages/ndigo-auth-server/src/*"],
      "@ndigo/auth-client": ["./packages/ndigo-auth-client/src"],
      "@ndigo/auth-client/*": ["./packages/ndigo-auth-client/src/*"],
      "@ndigo/openapi": ["./packages/ndigo-openapi/src"],
      "@ndigo/openapi/*": ["./packages/ndigo-openapi/src/*"],
      "@ndigo/generators": ["./packages/ndigo-generators/src"],
      "@ndigo/generators/*": ["./packages/ndigo-generators/src/*"],
      "@ndigo/test": ["./packages/ndigo-test/src"],
      "@ndigo/test/*": ["./packages/ndigo-test/src/*"],
      "@ndigo/inspect": ["./packages/ndigo-inspect/src"],
      "@ndigo/inspect/*": ["./packages/ndigo-inspect/src/*"],
      "@ndigo/locks": ["./packages/ndigo-locks/src"],
      "@ndigo/locks/*": ["./packages/ndigo-locks/src/*"],
      "@ndigo/rate-limit": ["./packages/ndigo-rate-limit/src"],
      "@ndigo/rate-limit/*": ["./packages/ndigo-rate-limit/src/*"],
      "@ndigo/flags": ["./packages/ndigo-flags/src"],
      "@ndigo/flags/*": ["./packages/ndigo-flags/src/*"],
      "@ndigo/flags-openfeature": ["./packages/ndigo-flags-openfeature/src"],
      "@ndigo/flags-openfeature/*": ["./packages/ndigo-flags-openfeature/src/*"],
      "@ndigo/cluster": ["./packages/ndigo-cluster/src"],
      "@ndigo/cluster/*": ["./packages/ndigo-cluster/src/*"],
      "@ndigo/cli": ["./packages/ndigo-cli/src"],
      "@ndigo/cli/*": ["./packages/ndigo-cli/src/*"],
      // redis subpaths first: /cache and /pubsub are declared above, /locks
      // joins the family (its driver is a top-level surface of @ndigo/redis).
      "@ndigo/redis/locks": ["./packages/ndigo-redis/src/locks"],
      "@ndigo/redis/locks/*": ["./packages/ndigo-redis/src/locks/*"],
      "@ndigo/redis/rate-limit": ["./packages/ndigo-redis/src/rate-limit"],
      "@ndigo/redis/rate-limit/*": ["./packages/ndigo-redis/src/rate-limit/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "apps/*/src/**/*.ts",
    "apps/*/test/**/*.ts",
    "apps/*/client/**/*.ts",
    "apps/*/client/**/*.d.ts"
  ],
  // Exclusions are anchored to BUILT OUTPUTS (SWP-M1): the old `**/lib/**`
  // also hid genuine sources like apps/11-ndigo-conduit-web/src/lib from the
  // lane. Playwright e2e specs stay excluded — they are not covered by any
  // tsc pass (deliberate: their globals are not in the 'types' array).
  "exclude": ["**/node_modules/**", "packages/*/lib/**", "apps/*/dist/**", "**/coverage/**", "**/e2e/**", "**/bench/**"]
}
