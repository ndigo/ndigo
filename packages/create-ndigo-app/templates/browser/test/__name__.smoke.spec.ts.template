/**
 * Smoke test (APP-N10): the browser entry app boots through the real
 * bootstrap path and dispatches the root route through the framework
 * pipeline (handler mapping → controller → Web Component view), driven by
 * the shared `@ndigo/test` browser harness (`bootWebApp` +
 * `MockWebClient`; guide 36 §3).
 */
// @vitest-environment jsdom
import '@tsmetadata/polyfill';
import { afterAll, beforeAll, describe, expect, test } from 'vitest';
import { bootWebApp, MockWebClient, installSynchronousAnimationFrames } from '@ndigo/test';
// Side effect: registers the `{{name}}-app` custom element.
import '../src/{{name}}-app-view';
import {{className}}Controller from '../src/{{name}}-controller';

describe('{{name}} smoke', () => {
    let browser: MockWebClient;
    let close: () => void;

    beforeAll(async () => {
        installSynchronousAnimationFrames();
        const app = await bootWebApp([{{className}}Controller]);
        browser = new MockWebClient(app);
        close = app.close;
    });

    afterAll(() => {
        close();
    });

    test('GET / renders the view with the default message', async () => {
        const render = await browser.dispatch('/');

        expect(render.model).toEqual({ message: 'Hello, World!' });
        const output = render.output;
        const tagName = output && typeof output === 'object' && 'tagName' in output ? String(output.tagName) : null;
        expect(tagName).toBe('{{upperName}}-APP');
    });
});
