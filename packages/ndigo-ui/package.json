{
  "name": "@ndigo/ui",
  "version": "0.0.1",
  "description": "Ndigo UI — brand tokens, theme layers, and the design-system registry contract",
  "keywords": [
    "ndigo",
    "ndigo-ui",
    "design-system",
    "design-tokens",
    "css",
    "web-components",
    "registry"
  ],
  "type": "module",
  "files": [
    "api",
    "lib",
    "tokens",
    "theme"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./tokens.css": "./tokens/ndigo-tokens.css",
    "./theme.css": "./theme/base.css",
    "./package.json": "./package.json"
  },
  "types": "lib/index.d.ts",
  "scripts": {
    "build:lib": "tsc -b tsconfig.build.json",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "author": "Jeff Rose <jeff_rose@outlook.com>",
  "license": "ISC",
  "sideEffects": [
    "**/*.css"
  ],
  "devDependencies": {
    "@internationalized/date": "^3.12.4",
    "@zag-js/accordion": "~1.47.0",
    "@zag-js/collection": "~1.47.0",
    "@zag-js/combobox": "~1.47.0",
    "@zag-js/core": "~1.47.0",
    "@zag-js/date-picker": "~1.47.0",
    "@zag-js/dialog": "~1.47.0",
    "@zag-js/menu": "~1.47.0",
    "@zag-js/navigation-menu": "~1.47.0",
    "@zag-js/popover": "~1.47.0",
    "@zag-js/scroll-area": "~1.47.0",
    "@zag-js/select": "~1.47.0",
    "@zag-js/slider": "~1.47.0",
    "@zag-js/switch": "~1.47.0",
    "@zag-js/tabs": "~1.47.0",
    "@zag-js/tooltip": "~1.47.0",
    "@zag-js/vanilla": "~1.47.0",
    "axe-core": "^4.14.0"
  }
}
