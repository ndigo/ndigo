{
  "extends": "../../tsconfig.build.json",
  "compilerOptions": {
    "composite": true,
    "declarationMap": false,
    "outDir": "lib",
    "paths": {
      "@blue/*": ["../blue-*"]
    },
    "rootDir": "src",
    "skipLibCheck": true
  },
  "exclude": ["node_modules/**/*", "**/*.spec.ts", "**/*.test.ts", "vite.config.ts", "vitest.config.ts", "test/**/*"],
  "include": ["src/**/*"]
}
