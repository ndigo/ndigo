{
  "name": "@blue/inspect",
  "version": "0.0.1",
  "description": "Deterministic JSON manifest generator for BlueJS applications (routes, mappings, config keys)",
  "keywords": [
    "blue",
    "bluejs",
    "blue-js",
    "inspect",
    "manifest",
    "introspection"
  ],
  "type": "module",
  "files": [
    "api",
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "lib/index.d.ts",
  "scripts": {
    "build:lib": "tsc -b tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "Jeff Rose <jeff_rose@outlook.com>",
  "license": "ISC",
  "dependencies": {
    "@blue/context": "~0.0.1",
    "@blue/core": "~0.0.1",
    "@blue/dispatcher": "~0.0.1",
    "@blue/router": "~0.0.1"
  },
  "devDependencies": {
    "@blue/boot": "~0.0.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "sideEffects": false
}
