{
  "name": "@blue/telemetry-web",
  "version": "0.0.1",
  "description": "Browser telemetry for BlueJS — browser telemetry configuration and web instrumentations",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "build:lib": "tsc -b tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "keywords": [
    "blue",
    "bluejs",
    "blue-js",
    "telemetry",
    "opentelemetry",
    "browser",
    "web"
  ],
  "license": "ISC",
  "sideEffects": false,
  "dependencies": {
    "@blue/telemetry": "~0.0.1",
    "@opentelemetry/api": "~1.9.1",
    "@opentelemetry/api-logs": "~0.222.0",
    "@opentelemetry/instrumentation": "~0.222.0",
    "@opentelemetry/resources": "~2.11.0",
    "@opentelemetry/sdk-logs": "~0.222.0",
    "@opentelemetry/sdk-metrics": "~2.11.0",
    "@opentelemetry/sdk-trace-base": "~2.11.0",
    "@opentelemetry/core": "~2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "~0.222.0"
  },
  "peerDependencies": {
    "@blue/context": "~0.0.1",
    "@blue/core": "~0.0.1",
    "@blue/dispatcher": "~0.0.1",
    "@blue/platform-web": "~0.0.1",
    "@blue/router": "~0.0.1"
  },
  "devDependencies": {
    "@blue/context": "~0.0.1",
    "@blue/core": "~0.0.1",
    "@blue/dispatcher": "~0.0.1",
    "@blue/platform-web": "~0.0.1",
    "@blue/router": "~0.0.1"
  }
}
