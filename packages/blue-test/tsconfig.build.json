{
  "extends": "../../tsconfig.build.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "lib",
    "rootDir": "src",
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "strict": true
  },
  "exclude": [
    "node_modules/**/*",
    "**/*.spec.ts",
    "**/*.test.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "test/**/*"
  ],
  "include": [
    "src/**/*"
  ]
}
