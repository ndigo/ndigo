{
  "extends": "../../tsconfig.build.json",
  "compilerOptions": {
    "baseUrl": ".",
    "composite": true,
    "outDir": "lib",
    "experimentalDecorators": false,
    "emitDecoratorMetadata": false,
    "useDefineForClassFields": true,
    "paths": {
      "@blue/*": ["../blue-*/index"]
    },
    "rootDir": "src",
    "skipLibCheck": true
  },
  "exclude": ["node_modules/**/*", "**/*.spec.ts", "**/*.test.ts", "vite.config.ts", "vitest.config.ts"],
  "include": ["src/**/*"]
}
