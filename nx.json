{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "build:lib": {
      "dependsOn": ["^build:lib"],
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/lib"]
    },

    "projects": {
      "blue-demo": {
        "root": "apps/blue-demo",
        "projectType": "application",
        "targets": {
          "dev": {
            "executor": "nx:run-commands",
            "options": {
              "command": "pnpm dev",
              "cwd": "apps/blue-demo"
            },
            "outputs": []
          },
          "build": {
            "executor": "nx:run-commands",
            "options": {
              "command": "pnpm build",
              "cwd": "apps/blue-demo"
            },
            "outputs": ["{projectRoot}/dist"]
          }
        }
      },
