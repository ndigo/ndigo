{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@blue/redis/cache": ["./packages/blue-redis/src/cache"],
      "@blue/redis/pubsub": ["./packages/blue-redis/src/pubsub"],
      "@blue/*": ["./packages/blue-*/src"]
    }
  },
  "include": ["packages/*/src/**/*", "apps/*/src/**/*"],
  "exclude": ["**/node_modules/**/*", "**/*.spec.ts", "**/*.test.ts"]
}
