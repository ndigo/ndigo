/**
 * @since 1.0.0
 * @author Jeff Rose
 */
export default class {{className}}App extends HTMLElement {
    set model(model: { message?: string }) {
        this.#message = model?.message ?? 'Hello, World!';
        this._render();
    }

    #message = 'Hello, World!';

    connectedCallback() {
        this._render();
    }

    _render() {
        this.replaceChildren();
        const heading = document.createElement('h1');
        heading.textContent = this.#message;
        const paragraph = document.createElement('p');
        paragraph.textContent = 'Welcome to Ndigo';
        this.append(heading, paragraph);
    }
}

window.customElements.define('{{name}}-app', {{className}}App);
