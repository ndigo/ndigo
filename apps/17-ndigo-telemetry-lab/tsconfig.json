{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    // ES2024 lib for `Promise.withResolvers` (the workspace's deferred-promise
    // idiom). DOM libs are listed explicitly because supplying `lib` replaces
    // the target's defaults — the browser client half typechecks against them.
    "lib": ["ES2024", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*"]
}
