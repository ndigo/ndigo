{
  "$schema": "https://json-schema.org/schema",
  "id": "BlueWicketComponent",
  "title": "Create a Wicket Component",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Component name in kebab-case (e.g., 'user-profile')",
      "x-prompt": "What is the component name?"
    },
    "type": {
      "type": "string",
      "description": "Component type",
      "enum": ["component", "container", "panel", "page"],
      "default": "panel",
      "x-prompt": "What type of Wicket component?"
    }
  },
  "required": ["name"]
}
