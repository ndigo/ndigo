{
  // Spec-typecheck lane (TST-A): typechecks every package/app source AND its
  // tests under the build chain's flags (it extends tsconfig.build.json, so the
  // IDE-only erasableSyntaxOnly rule is NOT enforced here and src/ stays green).
  // Paths mirror vitest.aliases.ts exactly (subpaths first); the wildcard siblings
  // map tsc's exact-match patterns onto the regex prefix aliases.
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node", "vitest/globals"],
    "paths": {
      "@blue/util/crypto": ["./packages/blue-util/src/crypto"],
      "@blue/util/crypto/*": ["./packages/blue-util/src/crypto/*"],
      "@blue/util/math": ["./packages/blue-util/src/math"],
      "@blue/util/math/*": ["./packages/blue-util/src/math/*"],
      "@blue/util/string": ["./packages/blue-util/src/string"],
      "@blue/util/string/*": ["./packages/blue-util/src/string/*"],
      "@blue/util/types": ["./packages/blue-util/src/type"],
      "@blue/util/types/*": ["./packages/blue-util/src/type/*"],
      "@blue/util/type": ["./packages/blue-util/src/type"],
      "@blue/util/type/*": ["./packages/blue-util/src/type/*"],
      "@blue/core": ["./packages/blue-core/src"],
      "@blue/core/*": ["./packages/blue-core/src/*"],
      "@blue/dom": ["./packages/blue-dom/src"],
      "@blue/dom/*": ["./packages/blue-dom/src/*"],
      "@blue/util": ["./packages/blue-util/src"],
      "@blue/util/*": ["./packages/blue-util/src/*"],
      "@blue/factory": ["./packages/blue-factory/src"],
      "@blue/factory/*": ["./packages/blue-factory/src/*"],
      "@blue/context": ["./packages/blue-context/src"],
      "@blue/context/*": ["./packages/blue-context/src/*"],
      "@blue/router": ["./packages/blue-router/src"],
      "@blue/router/*": ["./packages/blue-router/src/*"],
      "@blue/host": ["./packages/blue-host/src"],
      "@blue/host/*": ["./packages/blue-host/src/*"],
      "@blue/view": ["./packages/blue-view/src"],
      "@blue/view/*": ["./packages/blue-view/src/*"],
      "@blue/view-ejs": ["./packages/blue-view-ejs/src"],
      "@blue/view-ejs/*": ["./packages/blue-view-ejs/src/*"],
      "@blue/view-webcomponent": ["./packages/blue-view-webcomponent/src"],
      "@blue/view-webcomponent/*": ["./packages/blue-view-webcomponent/src/*"],
      "@blue/http": ["./packages/blue-http/src"],
      "@blue/http/*": ["./packages/blue-http/src/*"],
      "@blue/content": ["./packages/blue-content/src"],
      "@blue/content/*": ["./packages/blue-content/src/*"],
      "@blue/content-i18next": ["./packages/blue-content-i18next/src"],
      "@blue/content-i18next/*": ["./packages/blue-content-i18next/src/*"],
      "@blue/platform-web": ["./packages/blue-platform-web/src"],
      "@blue/platform-web/*": ["./packages/blue-platform-web/src/*"],
      "@blue/platform-node": ["./packages/blue-platform-node/src"],
      "@blue/platform-node/*": ["./packages/blue-platform-node/src/*"],
      "@blue/dispatcher": ["./packages/blue-dispatcher/src"],
      "@blue/dispatcher/*": ["./packages/blue-dispatcher/src/*"],
      "@blue/boot": ["./packages/blue-boot/src"],
      "@blue/boot/*": ["./packages/blue-boot/src/*"],
      "@blue/service": ["./packages/blue-service/src"],
      "@blue/service/*": ["./packages/blue-service/src/*"],
      "@blue/scheduler": ["./packages/blue-scheduler/src"],
      "@blue/scheduler/*": ["./packages/blue-scheduler/src/*"],
      "@blue/jobs": ["./packages/blue-jobs/src"],
      "@blue/jobs/*": ["./packages/blue-jobs/src/*"],
      "@blue/cache": ["./packages/blue-cache/src"],
      "@blue/cache/*": ["./packages/blue-cache/src/*"],
      "@blue/proxy": ["./packages/blue-proxy/src"],
      "@blue/proxy/*": ["./packages/blue-proxy/src/*"],
      "@blue/resilience": ["./packages/blue-resilience/src"],
      "@blue/resilience/*": ["./packages/blue-resilience/src/*"],
      "@blue/redis/cache": ["./packages/blue-redis/src/cache"],
      "@blue/redis/cache/*": ["./packages/blue-redis/src/cache/*"],
      "@blue/redis/pubsub": ["./packages/blue-redis/src/pubsub"],
      "@blue/redis/pubsub/*": ["./packages/blue-redis/src/pubsub/*"],
      "@blue/redis": ["./packages/blue-redis/src"],
      "@blue/redis/*": ["./packages/blue-redis/src/*"],
      "@blue/socket": ["./packages/blue-socket/src"],
      "@blue/socket/*": ["./packages/blue-socket/src/*"],
      "@blue/signals": ["./packages/blue-signals/src"],
      "@blue/signals/*": ["./packages/blue-signals/src/*"],
      "@blue/log": ["./packages/blue-log/src"],
      "@blue/log/*": ["./packages/blue-log/src/*"],
      "@blue/telemetry": ["./packages/blue-telemetry/src"],
      "@blue/telemetry/*": ["./packages/blue-telemetry/src/*"],
      "@blue/telemetry-node": ["./packages/blue-telemetry-node/src"],
      "@blue/telemetry-node/*": ["./packages/blue-telemetry-node/src/*"],
      "@blue/telemetry-web": ["./packages/blue-telemetry-web/src"],
      "@blue/telemetry-web/*": ["./packages/blue-telemetry-web/src/*"],
      "@blue/oxlint-plugin": ["./packages/blue-oxlint-plugin/src"],
      "@blue/oxlint-plugin/*": ["./packages/blue-oxlint-plugin/src/*"],
      "@blue/orm": ["./packages/blue-orm/src"],
      "@blue/orm/*": ["./packages/blue-orm/src/*"],
      "@blue/orm-drizzle": ["./packages/blue-orm-drizzle/src"],
      "@blue/orm-drizzle/*": ["./packages/blue-orm-drizzle/src/*"],
      "@blue/management": ["./packages/blue-management/src"],
      "@blue/management/*": ["./packages/blue-management/src/*"],
      "@blue/auth-core": ["./packages/blue-auth-core/src"],
      "@blue/auth-core/*": ["./packages/blue-auth-core/src/*"],
      "@blue/auth-server": ["./packages/blue-auth-server/src"],
      "@blue/auth-server/*": ["./packages/blue-auth-server/src/*"],
      "@blue/auth-client": ["./packages/blue-auth-client/src"],
      "@blue/auth-client/*": ["./packages/blue-auth-client/src/*"],
      "@blue/openapi": ["./packages/blue-openapi/src"],
      "@blue/openapi/*": ["./packages/blue-openapi/src/*"],
      "@blue/generators": ["./packages/blue-generators/src"],
      "@blue/generators/*": ["./packages/blue-generators/src/*"],
      "@blue/test": ["./packages/blue-test/src"],
      "@blue/test/*": ["./packages/blue-test/src/*"],
      "@blue/inspect": ["./packages/blue-inspect/src"],
      "@blue/inspect/*": ["./packages/blue-inspect/src/*"],
      "@blue/locks": ["./packages/blue-locks/src"],
      "@blue/locks/*": ["./packages/blue-locks/src/*"],
      "@blue/rate-limit": ["./packages/blue-rate-limit/src"],
      "@blue/rate-limit/*": ["./packages/blue-rate-limit/src/*"],
      "@blue/flags": ["./packages/blue-flags/src"],
      "@blue/flags/*": ["./packages/blue-flags/src/*"],
      "@blue/cluster": ["./packages/blue-cluster/src"],
      "@blue/cluster/*": ["./packages/blue-cluster/src/*"],
      "@blue/cli": ["./packages/blue-cli/src"],
      "@blue/cli/*": ["./packages/blue-cli/src/*"],
      // redis subpaths first: /cache and /pubsub are declared above, /locks
      // joins the family (its driver is a top-level surface of @blue/redis).
      "@blue/redis/locks": ["./packages/blue-redis/src/locks"],
      "@blue/redis/locks/*": ["./packages/blue-redis/src/locks/*"],
      "@blue/redis/rate-limit": ["./packages/blue-redis/src/rate-limit"],
      "@blue/redis/rate-limit/*": ["./packages/blue-redis/src/rate-limit/*"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "apps/*/src/**/*.ts",
    "apps/*/test/**/*.ts",
    "apps/*/client/**/*.ts",
    "apps/*/client/**/*.d.ts"
  ],
  // Exclusions are anchored to BUILT OUTPUTS (SWP-M1): the old `**/lib/**`
  // also hid genuine sources like apps/11-blue-conduit-web/src/lib from the
  // lane. Playwright e2e specs stay excluded — they are not covered by any
  // tsc pass (deliberate: their globals are not in the 'types' array).
  "exclude": ["**/node_modules/**", "packages/*/lib/**", "apps/*/dist/**", "**/coverage/**", "**/e2e/**", "**/bench/**"]
}
