{
  "name": "@ndigo/ui-web",
  "version": "0.0.1",
  "description": "Browser theme adapter for Ndigo UI — apply negotiated themes, persist the user's choice, and keep the DOM and context in sync",
  "keywords": [
    "ndigo",
    "ndigo-ui",
    "design-system",
    "theme",
    "browser",
    "web"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "build:lib": "tsc -b tsconfig.build.json",
    "test": "vitest run --config ../../vitest.config.ts",
    "test:watch": "vitest --config ../../vitest.config.ts"
  },
  "license": "ISC",
  "author": "Jeff Rose <jeff_rose@outlook.com>",
  "sideEffects": false,
  "dependencies": {
    "@ndigo/context": "~0.0.1",
    "@ndigo/platform-web": "~0.0.1",
    "@ndigo/router": "~0.0.1",
    "@ndigo/ui": "~0.0.1"
  },
  "files": [
    "api",
    "docs",
    "lib"
  ]
}
