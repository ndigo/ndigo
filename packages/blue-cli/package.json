{
  "name": "@blue/cli",
  "version": "0.0.1",
  "description": "The BlueJS framework CLI \u2014 serve, dev, generate, db, inspect, doctor (AD-75)",
  "type": "module",
  "keywords": [
    "bluejs",
    "blue-cli",
    "cli",
    "dev-loop"
  ],
  "files": [
    "bin",
    "api",
    "lib"
  ],
  "bin": {
    "blue": "./bin/run.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "types": "lib/index.d.ts",
  "scripts": {
    "build:lib": "tsc -b tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "oclif": {
    "commands": "./lib/commands",
    "additionalHelpFlags": [
      "-h"
    ],
    "additionalVersionFlags": [
      "-v"
    ],
    "topicSeparator": " "
  },
  "author": "Jeff Rose <jeff_rose@outlook.com>",
  "license": "ISC",
  "dependencies": {
    "@blue/cluster": "~0.0.1",
    "@oclif/core": "^5.0.0"
  },
  "devDependencies": {
    "@blue/orm-drizzle": "~0.0.1"
  },
  "sideEffects": false
}
