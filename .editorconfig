# Top-most Editor Config file
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
trim_trailing_whitespace = true

# JSON & YAML files
[**.{json,y*ml}]
index_size = 2

# JavaScript & TypeScript files
[**.{js,jsx,ts,tsx}]
indent_size = 4
insert_final_newline = true

# Markdown files
[**.md]
trim_trailing_whitespace = false