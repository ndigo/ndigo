/** @author Jeff Rose */
import { describe, expect, it } from 'vitest';
import { <%= className %> } from '../src/<%= fileName %>';

describe('<%= className %>', () => {
    it('should create an instance', () => {
        const instance = new <%= className %>('<%= fileName %>');
        expect(instance).toBeDefined();
        expect(instance.id).toBe('<%= fileName %>');
    });

    it('should have correct toStringTag', () => {
        const instance = new <%= className %>('<%= fileName %>');
        expect(Object.prototype.toString.call(instance)).toBe('[object <%= className %>]');
    });
});
