{
  "name": "@blue/js",
  "private": true,
  "version": "0.0.1",
  "description": "The BlueJS framework",
  "type": "module",
  "files": [
    "doc",
    "lib"
  ],
  "exports": "./lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "nx run-many -t build:lib",
    "test": "nx run-many -t test",
    "test:bench": "vitest bench --run --reporter verbose",
    "test:e2e": "nx run @blue/demo:test:e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doc": "pnpm doc:md",
    "doc:md": "typedoc",
    "doc:html": "typedoc --options typedoc.html.json",
    "doc:json": "typedoc --json doc-md/api.json",
    "doc:watch": "typedoc --watch",
    "lint:ast-grep": "ast-grep scan",
    "label-graph": "node label_injector.js",
    "label-labels": "node label_writer.js",
    "api-report": "nx run-many -t api-report",
    "digest": "repomix",
    "digest:compact": "repomix --compress"
  },
  "repository": {
    "type": "git",
    "url": "https://bitbucketdc-digital.jpmchase.net/scm/bluejs/blue.git"
  },
  "keywords": [
    "blue",
    "bluejs",
    "blue-js",
    "framework"
  ],
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.4.0",
  "author": "Jeff Rose <jeff_rose@outlook.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://go/bluejshelp"
  },
  "homepage": "https://bitbucketdc-digital.jpmchase.net/projects/BLUEJS/repos/blue/browse",
  "devDependencies": {
    "@ast-grep/cli": "~0.42.0",
    "@microsoft/api-extractor": "~7.58.0",
    "@nx/devkit": "~21.0.0",
    "@tsmetadata/polyfill": "^1.1.3",
    "@types/node": "~22.10.2",
    "@typescript-eslint/eslint-plugin": "~8.18.2",
    "@typescript-eslint/parser": "~8.18.2",
    "@vitejs/plugin-basic-ssl": "~1.1.0",
    "@vitest/ui": "~3.0.0",
    "benchmark": "~2.1.4",
    "cross-env": "~7.0.3",
    "debug": "~4.3.7",
    "eslint": "~9.17.0",
    "eslint-config-prettier": "~9.1.0",
    "eslint-plugin-prettier": "~5.2.1",
    "glob": "^13.0.0",
    "jsdom": "~25.0.1",
    "msw": "~2.7.0",
    "nx": "~21.0.0",
    "prettier": "~3.4.2",
    "repomix": "~0.2.0",
    "safe-regex": "^2.1.1",
    "typedoc": "^0.28.0",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "~6.0.3",
    "vitest": "~3.0.0"
  },
  "overrides": {
    "braces": ">=2.3.1",
    "handlebars": ">=4.7.7",
    "https-proxy-agent": ">=2.2.3"
  },
  "msw": {
    "workerDirectory": "test"
  }
}
