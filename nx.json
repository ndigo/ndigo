{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "build:lib": {
      "dependsOn": ["^build:lib"],
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/lib"]
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/test/**/*"
    ],
    "sharedGlobals": ["{workspaceRoot}/tsconfig.base.json"]
  },
  "plugins": [],
  "generators": {},
  "defaultProject": "@blue/core",
  "projects": {
    "@blue/demo": {
      "root": "apps/blue-demo",
      "projectType": "application",
      "targets": {
        "dev": {
          "executor": "nx:run-commands",
          "options": {
            "command": "pnpm dev",
            "cwd": "apps/blue-demo"
          },
          "outputs": []
        },
        "build": {
          "executor": "nx:run-commands",
          "options": {
            "command": "pnpm build",
            "cwd": "apps/blue-demo"
          },
          "outputs": ["{projectRoot}/dist"]
        },
        "e2e": {
          "executor": "nx:run-commands",
          "options": {
            "command": "pnpm test:e2e",
            "cwd": "apps/blue-demo"
          },
          "outputs": []
        }
      }
    },
    "@blue/hello": {
      "root": "apps/blue-hello",
      "projectType": "application",
      "targets": {
        "dev": {
          "executor": "nx:run-commands",
          "options": {
            "command": "pnpm dev",
            "cwd": "apps/blue-hello"
          },
          "outputs": []
        },
        "build": {
          "executor": "nx:run-commands",
          "options": {
            "command": "pnpm build",
            "cwd": "apps/blue-hello"
          },
          "outputs": ["{projectRoot}/dist"]
        }
      }
    }
  },
  "affected": {
    "defaultBase": "master"
  },
  "tasksRunnerOptions": {
    "default": {
      "runner": "nx/tasks-runners/default",
      "options": {
        "cacheableOperations": ["build:lib", "build:all", "test", "lint"],
        "parallel": 3
      }
    }
  }
}
