{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["./AGENTS.md"],
  "mcp": {
    "servers": {
      "graft": {
        "type": "local",
        "command": ["graft", "mcp"]
      }
    }
  },
  "lsp": {
    "typescript": {
      "command": ["tsc", "--lsp", "--stdio"],
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".mts", ".cts"]
    }
  },
  "worktree": {
    "directory": ".."
  }
}
