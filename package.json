{
  "name": "@ndigo/js",
  "private": true,
  "version": "0.0.1",
  "description": "The Ndigo framework",
  "type": "module",
  "scripts": {
    "build": "nx run-many -t build:lib",
    "build:all": "pnpm --filter todomvc-svelte build && pnpm --filter todomvc-vue build && pnpm --filter todomvc-react build && pnpm --filter todomvc-javascript-es6-webpack build",
    "test:benchmark": "node scripts/benchmark-quarantine.mjs ndigo",
    "test:benchmark:react": "pnpm exec tsx scripts/benchmark-dom.ts --impl react",
    "test:benchmark:svelte": "node scripts/benchmark-quarantine.mjs svelte",
    "test:benchmark:vue": "node scripts/benchmark-quarantine.mjs vue",
    "test:benchmark:vanilla": "pnpm exec tsx scripts/benchmark-dom.ts --impl vanilla",
    "test:benchmark:ndigo": "node scripts/benchmark-quarantine.mjs ndigo",
    "test": "nx run-many -t test",
    "bench": "node scripts/bench-run.mjs",
    "bench:quick": "node scripts/bench-run.mjs --quick",
    "bench:compare": "node scripts/bench-compare.mjs",
    "bench:report": "node scripts/bench-report.mjs",
    "bench:update": "node scripts/bench-run.mjs --update-baseline",
    "bench:http": "node benchmarks/http/run.mjs",
    "bench:start": "node benchmarks/startup/run.mjs",
    "test:bench": "node scripts/bench-run.mjs",
    "test:e2e": "nx run @ndigo/todo-web:test:e2e",
    "test:internal": "vitest run src/oxlint",
    "apps:smoke": "node scripts/apps-smoke.mjs",
    "typecheck": "pnpm --filter './packages/**' --filter './apps/**' --filter './tools/**' -r exec tsc -b tsconfig.build.json && pnpm exec tsc -p tsconfig.spec.json",
    "typecheck:fast": "pnpm --filter './packages/**' --filter './apps/**' --filter './tools/**' -r exec tsrs -b tsconfig.build.json && pnpm exec tsrs -p tsconfig.spec.json",
    "lint": "pnpm --filter @ndigo/oxlint-plugin build:lib && oxlint --type-aware --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "preflight": "node scripts/preflight.mjs",
    "preflight:fast": "node scripts/preflight.mjs --fast",
    "ci:usage": "node scripts/ci-usage.mjs",
    "doc": "pnpm doc:api",
    "doc:api": "node scripts/doc-api.mjs",
    "doc:check": "pnpm doc:api && git diff --exit-code -- packages API.md",
    "doc:coverage": "node scripts/doc-coverage.mjs --check",
    "doc:examples": "node scripts/doc-examples.mjs",
    "guides:check": "node scripts/check-guides.mjs",
    "docs:links": "node scripts/check-doc-links.mjs",
    "audit:dead": "knip",
    "db:schema:check": "node scripts/check-migration-schema.mjs",
    "manifest:check": "node scripts/check-manifests.mjs",
    "graft:build": "graft build --deep --allow-partial",
    "test:tooling": "node --test scripts/test-lower-decorators.mjs scripts/test-import-scanner.mjs scripts/test-package-surface.mjs",
    "postinstall": "node scripts/typedoc-ts-shim.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "agents:sync": "node ../development-agents/gen.mjs .",
    "agents:check": "node scripts/agents-check.mjs",
    "agent-content:build": "node tools/agent-content/build.mjs",
    "agent-content:check": "node tools/agent-content/build.mjs --check",
    "ui:a2ui-map:build": "node packages/ndigo-ui/scripts/build-a2ui-map.mjs",
    "ui:a2ui-map:check": "node packages/ndigo-ui/scripts/build-a2ui-map.mjs --check",
    "storybook": "pnpm --filter @ndigo/ui-storybook storybook",
    "build:storybook": "pnpm --filter @ndigo/ui-storybook build-storybook"
  },
  "keywords": [
    "ndigo",
    "ndigo",
    "ndigo-js",
    "framework"
  ],
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.16.1",
  "author": "Jeff Rose <jeff_rose@outlook.com>",
  "license": "ISC",
  "devDependencies": {
    "@nx/devkit": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@tsmetadata/polyfill": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "^0.28.2",
    "jsdom": "~30.1.3",
    "knip": "^6.44.1",
    "msw": "~3.0.3",
    "@microsoft/tsdoc": "^0.17.1",
    "nx": "catalog:",
    "oxfmt": "^0.76.0",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "^7.0.2005",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "tsx": "catalog:",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "catalog:",
    "typescript-6": "npm:typescript@6.0.3",
    "vitest": "catalog:"
  }
}
