  "license": "ISC",
  "dependencies": {
    "@blue/core": "~0.0.1",
    "@blue/dispatcher": "~0.0.1",
    "@blue/http": "~0.0.1",
    "zod": "catalog:"
  },
  "sideEffects": false,
  "devDependencies": {
    "@blue/context": "~0.0.1"
  }
