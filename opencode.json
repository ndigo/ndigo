{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "./AGENTS.md"
  ],
  "mcp": {
    "servers": {
      "graft": {
        "type": "local",
        "command": [
          "graft",
          "mcp"
        ]
      }
    },
    "graft": {
      "type": "local",
      "command": [
        "graft",
        "mcp"
      ],
      "enabled": true
    }
  },
  "lsp": {
    "typescript": {
      "command": [
        "tsc",
        "--lsp",
        "--stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".mts",
        ".cts"
      ]
    }
  },
  "worktree": {
    "directory": ".."
  }
}
