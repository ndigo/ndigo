import type { AbstractDispatcher } from '@ndigo/dispatcher';
import { McpToolRegistry, startStdioServer } from '@ndigo/mcp';

/**
 * MCP wiring generated by `ndigo add @ndigo/mcp`.
 *
 * Pass the dispatcher from the booted application to expose every
 * `@toolMapping` handler over stdio. Register
 * `src/mcp-sample-controller.ts` in the application assembly so the sample
 * tool is reachable.
 */
export async function serveMcp(
    dispatcher: AbstractDispatcher,
    options: { readOnly?: boolean } = {}
): Promise<void> {
    const registry = McpToolRegistry.from(dispatcher, { readOnly: options.readOnly === true });
    await startStdioServer(registry);
}
