{
  "name": "@ndigo/cli",
  "version": "0.0.1",
  "description": "The Ndigo framework CLI — app lifecycle, scaffolding, db migrations, and DX commands",
  "type": "module",
  "keywords": [
    "ndigo",
    "ndigo-cli",
    "cli",
    "dev-loop"
  ],
  "files": [
    "bin",
    "api",
    "lib",
    "assets"
  ],
  "bin": {
    "ndigo": "./bin/run.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "types": "lib/index.d.ts",
  "scripts": {
    "build:lib": "tsc -b tsconfig.build.json",
    "test": "vitest run --config ../../vitest.config.ts",
    "test:watch": "vitest --config ../../vitest.config.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "author": "Jeff Rose <jeff_rose@outlook.com>",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@ndigo/cluster": "~0.0.1",
    "@stricli/core": "^1.3.0",
    "@toon-format/toon": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ndigo/orm-drizzle": "~0.0.1"
  },
  "sideEffects": false
}
