{
  "name": "@blue/eslint-plugin",
  "version": "0.0.1",
  "description": "Custom ESLint rules for BlueJS architectural enforcement",
  "type": "module",
  "files": [
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "types": "lib/index.d.ts",
  "scripts": {
    "build:lib": "tsc -b tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "api-report": "api-extractor run --local --verbose"
  },
  "dependencies": {
    "@oxlint/plugins": "^1.78.0"
  },
  "devDependencies": {
    "oxlint": "^1.78.0",
    "typescript": "~5.8.0",
    "vitest": "~3.0.0"
  },
  "peerDependencies": {
    "oxlint": ">=1.0.0"
  },
  "keywords": [
    "blue",
    "bluejs",
    "eslint",
    "eslint-plugin",
    "architecture"
  ],
  "license": "ISC",
  "author": "Jeff Rose <jeff_rose@outlook.com>",
  "repository": {
    "type": "git",
    "url": "https://bitbucketdc-digital.jpmchase.net/scm/bluejs/blue.git",
    "directory": "packages/blue-eslint-plugin"
  }
