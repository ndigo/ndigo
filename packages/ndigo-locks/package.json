  "description": "Distributed locks with fencing tokens for Node.js — the single-executor primitive behind multi-node @scheduled and cluster work",
  "type": "module",
  "keywords": [
    "ndigo",
    "ndigo-locks",
    "locks",
    "fencing",
    "distributed"
  ],
  "files": [
    "api",
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "types": "lib/index.d.ts",
  "scripts": {
    "build:lib": "tsc -b tsconfig.build.json",
    "test": "vitest run --config ../../vitest.config.ts",
    "test:watch": "vitest --config ../../vitest.config.ts"
  },
  "author": "Jeff Rose <jeff_rose@outlook.com>",
  "license": "ISC",
  "dependencies": {
    "@ndigo/core": "~0.0.1",
    "@ndigo/factory": "~0.0.1",
    "@ndigo/util": "~0.0.1"
