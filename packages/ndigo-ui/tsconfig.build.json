{
  "extends": "../../tsconfig.build.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2024"],
    "outDir": "lib",
    "rootDir": "src",
    "skipLibCheck": true,
    "strict": true
  },
  "exclude": ["node_modules/**/*", "**/*.spec.ts", "**/*.test.ts", "vite.config.ts", "vitest.config.ts"],
  "include": ["src/**/*"]
}
