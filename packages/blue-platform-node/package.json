{
  "name": "@blue/platform-node",
  "version": "0.0.1",
  "description": "Node.js platform adapter for BlueJS \u2014 HTTP server, auto-configuration, static files, multipart",
  "type": "module",
  "files": [
    "doc",
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./node-auto-configuration": {
      "types": "./lib/node-auto-configuration.d.ts",
      "default": "./lib/node-auto-configuration.js"
    }
  },
  "types": "lib/index.d.ts",
  "scripts": {
    "build:lib": "tsc -b tsconfig.build.json",
    "test": "vitest run"
  },
  "keywords": [
    "blue",
    "bluejs",
    "blue-js",
    "blue-platform",
    "blue-platform-node",
    "platform",
    "node"
  ],
  "author": "Jeff Rose <jeff_rose@outlook.com>",
  "license": "ISC",
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/ws": "catalog:",
    "zod": "catalog:"
  },
  "sideEffects": false,
  "dependencies": {
    "@blue/auth-core": "~0.0.1",
    "@blue/cache": "~0.0.1",
    "@blue/context": "~0.0.1",
    "@blue/core": "~0.0.1",
    "@blue/dispatcher": "~0.0.1",
    "@blue/factory": "~0.0.1",
    "@blue/http": "~0.0.1",
    "@blue/log": "~0.0.1",
    "@blue/openapi": "~0.0.1",
    "@blue/router": "~0.0.1",
    "@blue/scheduler": "~0.0.1",
    "@blue/socket": "~0.0.1",
    "@blue/util": "~0.0.1",
    "@blue/view": "~0.0.1",
    "@tsmetadata/polyfill": "catalog:",
    "busboy": "^1.6.0",
    "helmet": "^8.3.0",
    "ws": "catalog:"
  },
  "peerDependencies": {
    "swagger-ui-dist": "5.33.0"
  }
