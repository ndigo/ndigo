 * @author Jeff Rose
 */
import { getMapping, parameters, queryValue, requestMapping } from '@ndigo/dispatcher';

@requestMapping('/')
export class {{className}}Controller {
    @getMapping('/')
    index() {
        return { message: 'Hello, World!' };
    }

    @getMapping('/hello')
    @parameters({ name: queryValue('name') })
    hello(name?: string) {
        return { message: `Hello, ${name || 'World'}!` };
    }
}
