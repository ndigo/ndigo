{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "parallel": 3,
  "targetDefaults": {
    "build:lib": {
      "dependsOn": ["^build:lib"],
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/lib"]
    },
    "test": {
      "dependsOn": ["^build:lib"],
      "cache": true
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/test/**/*"
    ],
    "sharedGlobals": ["{workspaceRoot}/tsconfig.base.json", "{workspaceRoot}/tsconfig.build.json"]
  },
  "plugins": [],
  "generators": {},
  "defaultBase": "master",
  "nxCloudId": "6ae63713aff2508553e63b69"
}
