{
  "$schema": "http://json-schema.org/schema",
  "cli": "nx",
  "title": "Service Generator",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "service name"
    },
    "package": {
      "type": "string",
      "description": "Target package"
    },
    "className": {
      "type": "string",
      "description": "Class name override"
    },
    "summary": {
      "type": "string",
      "description": "One-line summary"
    }
  },
  "required": ["name", "package"]
}
