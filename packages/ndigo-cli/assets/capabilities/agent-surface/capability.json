{
  "id": "agent-surface",
  "kind": "capability",
  "summary": "Expose an application's dispatch handlers as MCP tools over a stdio server.",
  "packages": ["@ndigo/mcp"],
  "guide": "48-agent-facing-surfaces",
  "ops": [
    {
      "op": "addDependency",
      "packages": ["@ndigo/mcp"]
    },
    {
      "op": "writeFile",
      "template": "templates/mcp.ts.tmpl",
      "path": "src/mcp.ts"
    },
    {
      "op": "editJson",
      "path": "package.json",
      "pointer": "/scripts/mcp",
      "value": "tsx src/mcp.ts"
    }
  ],
  "checks": ["route-parity:*", "mcp-stdio:tools/list"]
}
