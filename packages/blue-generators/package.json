{
  "name": "@blue/generators",
  "version": "0.0.1",
  "description": "Nx generators for BlueJS package and component scaffolding",
  "type": "module",
  "generators": "./generators.json",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "generators.json"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nx/devkit": "~22.0.0"
  },
  "devDependencies": {
    "nx": "~22.7.7",
    "typescript": "~5.8.0",
    "vitest": "~3.0.0"
  },
  "author": "Jeff Rose <jeff_rose@outlook.com>",
  "license": "ISC",
  "sideEffects": false
}
