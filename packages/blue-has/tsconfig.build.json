{
  "extends": "../../tsconfig.build.json",
  "compilerOptions": {
    "baseUrl": ".",
    "composite": true,
    "lib": ["DOM", "ESNext"],
    "outDir": "lib",
    "rootDir": "src",
    "skipLibCheck": true,
    "target": "ESNext"
  },
  "exclude": ["node_modules/**/*", "vite.config.ts", "vitest.config.ts"],
  "include": ["src/**/*", "src/javascript/globals.d.ts"]
}
