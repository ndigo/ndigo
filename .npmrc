# Monorepo Compatibility
strict-peer-dependencies=false
auto-install-peers=true

# Workspace Configuration
# NOTE: link-workspace-packages, prefer-workspace-packages, and save-workspace-protocol
# moved to pnpm-workspace.yaml in pnpm 10+

# Strictness & Quality
engine-strict=true

# Performance
prefer-offline=true

# Security overrides live in pnpm-workspace.yaml (`overrides:`), alongside the
# rest of the workspace configuration that moved there in pnpm 10+. pnpm never
# read them from this file.
