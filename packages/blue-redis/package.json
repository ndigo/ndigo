{
  "name": "@blue/redis",
  "version": "0.0.1",
  "description": "Node-only Redis connections, namespaced shared cache adapters, WebSocket pub/sub fan-out, distributed-lock/job drivers, and the shared-store rate limiter for BlueJS",
  "type": "module",
  "files": [
    "api",
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cache": {
      "types": "./lib/cache/index.d.ts",
      "default": "./lib/cache/index.js"
    },
    "./pubsub": {
      "types": "./lib/pubsub/index.d.ts",
      "default": "./lib/pubsub/index.js"
    },
    "./jobs": {
      "types": "./lib/jobs/index.d.ts",
      "default": "./lib/jobs/index.js"
    },
    "./locks": {
      "types": "./lib/locks/index.d.ts",
      "default": "./lib/locks/index.js"
    },
    "./rate-limit": {
      "types": "./lib/rate-limit/index.d.ts",
      "default": "./lib/rate-limit/index.js"
    }
  },
  "types": "lib/index.d.ts",
  "scripts": {
    "build:lib": "tsc -b tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "author": "Jeff Rose <jeff_rose@outlook.com>",
  "license": "ISC",
  "keywords": [
    "bluejs",
    "redis",
    "cache",
    "pubsub",
    "websocket",
    "node"
  ],
  "dependencies": {
    "@blue/core": "~0.0.1",
    "@blue/log": "~0.0.1",
    "@redis/client": "6.3.0"
  },
  "devDependencies": {
    "@blue/platform-node": "~0.0.1",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "vitest": "catalog:",
    "ws": "catalog:"
  },
  "peerDependencies": {
    "@blue/cache": "~0.0.1",
    "@blue/factory": "~0.0.1",
    "@blue/jobs": "~0.0.1",
    "@blue/locks": "~0.0.1",
    "@blue/rate-limit": "~0.0.1",
    "@blue/socket": "~0.0.1"
  },
  "peerDependenciesMeta": {
    "@blue/cache": {
      "optional": true
    },
    "@blue/factory": {
      "optional": true
    },
    "@blue/jobs": {
      "optional": true
    },
    "@blue/locks": {
      "optional": true
    },
    "@blue/rate-limit": {
      "optional": true
    },
    "@blue/socket": {
      "optional": true
    }
  },
  "sideEffects": false
}
