{
  "name": "@blue/generators",
  "version": "0.0.1",
  "description": "Nx generators for BlueJS package and component scaffolding",
  "keywords": [
    "bluejs",
    "nx",
    "generator",
    "scaffolding"
  ],
  "type": "module",
  "generators": "./generators.json",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "doc",
    "generators.json"
  ],
  "scripts": {
    "build:lib": "tsc -b tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nx/devkit": "~23.2.0"
  },
  "devDependencies": {
    "nx": "~23.2.0",
    "typescript": "~6.0.3",
    "vitest": "~4.0.18"
  },
  "author": "Jeff Rose <jeff_rose@outlook.com>",
  "license": "ISC",
  "sideEffects": false
}
