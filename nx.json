{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "parallel": 3,
  "targetDefaults": {
    "build:lib": {
      "dependsOn": ["^build:lib"],
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/lib"]
    },
    "api-report": {
      "dependsOn": ["build:lib"],
      "cache": true,
      "inputs": ["production"],
      "outputs": ["{projectRoot}/etc"]
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/test/**/*"
    ],
    "sharedGlobals": ["{workspaceRoot}/tsconfig.base.json"]
  },
  "plugins": [],
  "generators": {},
  "projects": {
    "@blue/todo": {
      "root": "apps/blue-todo",
      "projectType": "application",
      "targets": {
        "dev": {
          "executor": "nx:run-commands",
          "options": {
            "command": "pnpm dev",
            "cwd": "apps/blue-todo"
          },
          "outputs": []
        },
        "build": {
          "executor": "nx:run-commands",
          "options": {
            "command": "pnpm build",
            "cwd": "apps/blue-todo"
          },
          "outputs": ["{projectRoot}/dist"]
        },
        "e2e": {
          "executor": "nx:run-commands",
          "options": {
            "command": "pnpm test:e2e",
            "cwd": "apps/blue-todo"
          },
          "outputs": []
        }
      }
    },
    "@blue/hello": {
      "root": "apps/blue-hello",
      "projectType": "application",
      "targets": {
        "dev": {
          "executor": "nx:run-commands",
          "options": {
            "command": "pnpm dev",
            "cwd": "apps/blue-hello"
          },
          "outputs": []
        },
        "build": {
          "executor": "nx:run-commands",
          "options": {
            "command": "pnpm build",
            "cwd": "apps/blue-hello"
          },
          "outputs": ["{projectRoot}/dist"]
        }
      }
    },
    "@blue/api": {
      "root": "apps/blue-api",
      "projectType": "application",
      "targets": {
        "start": {
          "executor": "nx:run-commands",
          "options": {
            "command": "pnpm start",
            "cwd": "apps/blue-api"
          },
          "outputs": []
        }
      }
    },
    "@blue/todomvc": {
      "root": "../todomvc/examples/bluejs",
      "projectType": "application",
      "targets": {
        "build:lib": {
          "executor": "nx:run-commands",
          "options": {
            "command": "vite build",
            "cwd": "../todomvc/examples/bluejs"
          }
        }
      }
    }
  },
  "affected": {
    "defaultBase": "master"
  }
}
