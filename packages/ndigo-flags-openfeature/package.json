{
  "name": "@ndigo/flags-openfeature",
  "version": "0.0.1",
  "description": "OpenFeature bridge for Ndigo flags — the FlagEvaluator over @openfeature/server-sdk (and the web SDK for the ./web entry), so vendor providers (flagd, OFREP, LaunchDarkly, …) arrive behind the existing SPI",
  "type": "module",
  "keywords": [
    "ndigo",
    "ndigo-flags",
    "feature-flags",
    "openfeature"
  ],
  "files": [
    "api",
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./web": {
      "types": "./lib/web/index.d.ts",
      "default": "./lib/web/index.js"
    }
  },
  "types": "lib/index.d.ts",
  "scripts": {
    "build:lib": "tsc -b tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "Jeff Rose <jeff_rose@outlook.com>",
  "license": "ISC",
  "dependencies": {
    "@ndigo/flags": "~0.0.1",
    "@opentelemetry/api": "catalog:"
  },
  "devDependencies": {
    "@openfeature/server-sdk": "catalog:",
    "@openfeature/web-sdk": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:"
  },
  "peerDependencies": {
    "@openfeature/server-sdk": "^1.23.0",
    "@openfeature/web-sdk": "^1.10.0"
  },
  "sideEffects": false
}
