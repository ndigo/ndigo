{
  "name": "@blue/openapi",
  "version": "0.0.1",
  "description": "OpenAPI 3.0 documentation for BlueJS apps \u2014 spec generation from dispatch metadata + Swagger UI",
  "keywords": [
    "blue",
    "bluejs",
    "blue-js",
    "openapi",
    "swagger",
    "api-docs"
  ],
