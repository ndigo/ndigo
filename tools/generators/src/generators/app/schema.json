{
  "$schema": "https://json-schema.org/schema",
  "id": "NdigoApp",
  "title": "Create a Ndigo example application",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "App slug (kebab-case, without the 'ndigo-' prefix)",
      "x-prompt": "What is the app name? (e.g., 'todo-widget')"
    },
    "kind": {
      "type": "string",
      "enum": [
        "browser",
        "node"
      ],
      "description": "browser = Vite SPA, node = HTTP server",
      "x-prompt": null
    },
    "description": {
      "type": "string",
      "description": "One-line description used in the manifest and README",
      "default": ""
    },
    "number": {
      "type": "number",
      "description": "Reading-order number (defaults to the next free)",
      "minimum": 1
    },
    "port": {
      "type": "number",
      "description": "Dev port (defaults to the first free multiple-of-ten slot)",
      "minimum": 1,
      "maximum": 65535
    },
    "preset": {
      "type": "string",
      "enum": [
        "api",
        "browser",
        "full-stack",
        "minimal"
      ],
      "description": "Starter preset (defaults to minimal)"
    }
  },
  "required": [
    "name"
  ]
}
