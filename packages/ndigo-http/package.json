{
  "name": "@ndigo/http",
  "version": "0.0.1",
  "description": "Fetch-based HTTP client, interceptors, and content parsing for Ndigo",
  "keywords": [
    "ndigo",
    "ndigo",
    "ndigo-js",
    "ndigo-http",
    "http",
    "http-request",
    "fetch",
    "xhr",
    "xmlhttprequest"
  ],
  "type": "module",
  "files": [
    "api",
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./transformers": {
      "types": "./lib/transformers/index.d.ts",
      "import": "./lib/transformers/index.js"
    }
  },
  "types": "lib/index.d.ts",
  "scripts": {
    "build:lib": "tsc -b tsconfig.build.json",
    "test": "vitest run --config ../../vitest.config.ts",
    "test:watch": "vitest --config ../../vitest.config.ts"
  },
  "author": "Jeff Rose <jeff_rose@outlook.com>",
  "license": "ISC",
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "catalog:",
    "@opentelemetry/core": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:"
  },
  "sideEffects": false,
  "dependencies": {
    "@ndigo/core": "~0.0.1",
    "@ndigo/factory": "~0.0.1",
    "@ndigo/util": "~0.0.1",
    "@opentelemetry/api": "catalog:"
  }
}
