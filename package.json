{
  "name": "@blue/js",
  "private": true,
  "version": "3.0.0-alpha.0",
  "description": "The BlueJS framework",
  "type": "module",
  "files": [
    "doc",
    "lib"
  ],
  "exports": "./lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "nx run-many -t build:lib",
    "test": "nx run-many -t test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doc": "pnpm doc:md",
    "doc:md": "typedoc",
    "doc:html": "typedoc --options typedoc.html.json",
    "doc:json": "typedoc --json doc-md/api.json",
    "doc:watch": "typedoc --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://bitbucketdc-digital.jpmchase.net/scm/bluejs/blue.git"
  },
  "keywords": [
    "blue",
    "bluejs",
    "blue-js",
    "framework"
  ],
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "author": "Jeff Rose <jeff_rose@outlook.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://go/bluejshelp"
  },
  "homepage": "https://bitbucketdc-digital.jpmchase.net/projects/BLUEJS/repos/blue/browse",
  "devDependencies": {
    "@types/node": "~22.10.2",
    "@typescript-eslint/eslint-plugin": "~8.18.2",
    "@typescript-eslint/parser": "~8.18.2",
    "@vitejs/plugin-basic-ssl": "~1.1.0",
    "@vitest/ui": "~2.1.8",
    "benchmark": "~2.1.4",
    "cross-env": "~7.0.3",
    "debug": "~4.3.7",
    "eslint": "~9.17.0",
    "eslint-config-prettier": "~9.1.0",
    "eslint-plugin-prettier": "~5.2.1",
    "glob": "^13.0.0",
    "jsdom": "~25.0.1",
    "msw": "~2.7.0",
    "nx": "~20.3.2",
    "prettier": "~3.4.2",
    "process": "~0.11.10",
    "ramda": "~0.32.0",
    "reflect-metadata": "~0.2.2",
    "ts-node": "~10.9.2",
    "typedoc": "^0.27.9",
    "typedoc-plugin-markdown": "^4.3.0",
    "typescript": "~5.7.2",
    "util": "~0.12.4",
    "vitest": "~2.1.8"
  },
  "pnpm": {
    "overrides": {
      "braces": ">=2.3.1",
      "handlebars": ">=4.7.7",
      "https-proxy-agent": ">=2.2.3"
    },
    "patchedDependencies": {}
  },
  "msw": {
    "workerDirectory": "test"
  }
}
