{
  "$schema": "https://typedoc.org/schema.json",
  "name": "BlueJS Framework",
  "entryPointStrategy": "resolve",
  "entryPoints": [
    "packages/blue-core/src/index.ts",
    "packages/blue-util/src/index.ts",
    "packages/blue-context/src/index.ts",
    "packages/blue-router/src/index.ts",
    "packages/blue-view/src/index.ts",
    "packages/blue-view-ejs/src/index.ts",
    "packages/blue-http/src/index.ts",
    "packages/blue-content/src/index.ts",
    "packages/blue-boot/src/index.ts",
    "packages/blue-service/src/index.ts",
    "packages/blue-dispatcher/src/index.ts",
    "packages/blue-view-webcomponent/src/index.ts",
    "packages/blue-platform-web/src/index.ts",
    "packages/blue-factory/src/index.ts",
    "packages/blue-dom/src/index.ts",
    "packages/blue-oxlint-plugin/src/index.ts",
    "packages/blue-orm/src/index.ts",
    "packages/blue-orm-drizzle/src/index.ts",
    "packages/blue-platform-node/src/index.ts",
    "packages/blue-signals/src/index.ts",
    "packages/blue-telemetry/src/index.ts",
    "packages/blue-telemetry-node/src/index.ts",
    "packages/blue-telemetry-web/src/index.ts",
    "packages/blue-test/src/index.ts",
    "packages/blue-management/src/index.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/test/**",
    "archive/**"
  ],
  "out": "doc-md",
  "plugin": [
    "typedoc-plugin-markdown",
    "./scripts/typedoc-tags-plugin.mjs"
  ],
  "readme": "README.md",
  "categorizeByGroup": true,
  "categoryOrder": [
    "Function",
    "List",
    "Object",
    "String",
    "Type",
    "Logic",
    "Math",
    "Relation",
    "*"
  ],
  "excludePrivate": true,
  "excludeProtected": false,
  "excludeInternal": false,
  "includeVersion": true,
  "sort": [
    "source-order"
  ],
  "gitRevision": "main",
  "sourceLinkTemplate": "https://bitbucketdc-digital.jpmchase.net/scm/bluejs/blue/src/{gitRevision}/{path}#lines-{line}",
  "skipErrorChecking": true,
  "treatWarningsAsErrors": true,
  "treatValidationWarningsAsErrors": true,
  "compilerOptions": {
    "skipLibCheck": true,
    "noEmit": true
  },
  "externalSymbolLinkMappings": {
    "@blue/platform-node": {
      "NodeDispatcher": "#",
      "HTTPServer": "#",
      "ResourceLoader": "#",
      "UnresolvedResource": "#"
    },
    "@blue/platform-web": {
      "BrowserDispatcher": "#"
    },
    "@blue/router": {
      "Route": "#"
    },
    "@blue/view": {
      "View": "#",
      "ProducerView": "#",
      "ViewTarget": "#"
    },
    "@blue/dispatcher": {
      "RouteHandlerInterceptor": "#",
      "Dispatcher": "#",
      "ModelAndView": "#",
      "ViewNameTranslator": "#",
      "ParameterBindingError": "#",
      "SocketSession": "#",
      "AbstractRouteErrorResolver": "#"
    },
    "@blue/context": {
      "ResourceLoaderAware": "#",
      "ApplicationEventEmitterAware": "#",
      "ContentSourceAware": "#",
      "ContentSource": "#",
      "EntryRegistryProcessor": "#",
      "LifecycleProcessor": "#",
      "ResourceLoader": "#"
    },
    "@blue/telemetry": {
      "FeatureMetricAggregator": "#",
      "LoggerFactory": "#"
    },
    "@blue/http": {
      "ResponseError": "#",
      "CompletionAwareHTTPInterceptor": "#",
      "ErrorAwareHTTPInterceptor": "#",
      "InitializationAwareHTTPInterceptor": "#",
      "RequestAwareHTTPInterceptor": "#",
      "ResponseAwareHTTPInterceptor": "#"
    },
    "@blue/core": {
      "Factory": "#",
      "EntryProcessor": "#",
      "reduce": "#",
      "Map": "#",
      "string": "#"
    },
    "@blue/factory": {
      "ContextToken": "#",
      "Factory": "#",
      "InitializationAwareProcessor": "#",
      "Initializable": "#",
      "EntryRegistryProcessor": "#"
    },
    "@blue/content": {
      "ContentSource": "#"
    },
    "typescript": {
      "external": "#"
    }
  },
  "gitRemote": "bluejs/blue"
}
