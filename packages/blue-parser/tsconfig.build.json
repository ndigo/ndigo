{
  "extends": "../../tsconfig.build.json",
  "compilerOptions": {
    "baseUrl": ".",
    "composite": true,
    "outDir": "lib",
    "paths": {
      "@blue/*": ["../blue-*/lib", "../blue-*/src"]
    },
    "rootDir": "src",
    "skipLibCheck": true
  },
  "exclude": ["node_modules/**/*", "**/*.spec.ts", "**/*.test.ts", "vite.config.ts", "vitest.config.ts"],
  "include": ["src/**/*"],
  "references": [{ "path": "../blue-util/tsconfig.build.json" }]
}
