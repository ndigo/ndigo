{
  "$schema": "https://json-schema.org/schema",
  "id": "BluePackage",
  "title": "Create a BlueJS Package",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "The package name (kebab-case, without 'blue-' prefix)",
      "x-prompt": "What is the package name? (e.g., 'telemetry-otel')"
    },
    "description": {
      "type": "string",
      "description": "Short package description",
      "default": ""
    }
  },
  "required": ["name"]
}
