{
  "generators": {
    "app": {
      "factory": "./src/generators/app/generator",
      "schema": "./src/generators/app/schema.json",
      "description": "Generate a Ndigo example application under apps/ (node or browser kind)"
    },
    "package": {
      "factory": "./src/generators/package/generator",
      "schema": "./src/generators/package/schema.json",
      "description": "Generate a new @ndigo/* package with the standard Ndigo skeleton"
    },
    "component": {
      "factory": "./src/generators/component/generator",
      "schema": "./src/generators/component/schema.json",
      "description": "Generate a source file + test file pair with Ndigo conventions"
    },
    "header": {
      "factory": "./src/generators/header/generator",
      "schema": "./src/generators/header/schema.json",
      "description": "Add or replace the standard Ndigo documentation header on a source file"
    },
    "readme": {
      "factory": "./src/generators/readme/generator",
      "schema": "./src/generators/readme/schema.json",
      "description": "Scaffold a new package README on the standard Ndigo template"
    },
    "controller": {
      "factory": "./src/generators/controller/generator",
      "schema": "./src/generators/controller/schema.json",
      "description": "Generate a controller source file"
    },
    "service": {
      "factory": "./src/generators/service/generator",
      "schema": "./src/generators/service/schema.json",
      "description": "Generate a service source file"
    },
    "entity": {
      "factory": "./src/generators/entity/generator",
      "schema": "./src/generators/entity/schema.json",
      "description": "Generate an @ndigo/orm entity class"
    },
    "middleware": {
      "factory": "./src/generators/middleware/generator",
      "schema": "./src/generators/middleware/schema.json",
      "description": "Generate a middleware source file"
    },
    "config": {
      "factory": "./src/generators/config/generator",
      "schema": "./src/generators/config/schema.json",
      "description": "Generate a config source file"
    },
    "migration": {
      "factory": "./src/generators/component/generator",
      "schema": "./src/generators/component/schema.json",
      "description": "Generate a migration source file (scaffold)"
    },
    "redis-setup": {
      "factory": "./src/generators/redis-setup/generator",
      "schema": "./src/generators/redis-setup/schema.json",
      "description": "Wire @ndigo/redis into an application"
    },
    "jobs-setup": {
      "factory": "./src/generators/jobs-setup/generator",
      "schema": "./src/generators/jobs-setup/schema.json",
      "description": "Wire @ndigo/jobs into an application"
    },
    "socket-setup": {
      "factory": "./src/generators/socket-setup/generator",
      "schema": "./src/generators/socket-setup/schema.json",
      "description": "Wire @ndigo/socket into an application"
    },
    "cache-setup": {
      "factory": "./src/generators/cache-setup/generator",
      "schema": "./src/generators/cache-setup/schema.json",
      "description": "Wire @ndigo/cache into an application"
    },
    "mcp-setup": {
      "factory": "./src/generators/mcp-setup/generator",
      "schema": "./src/generators/mcp-setup/schema.json",
      "description": "Wire @ndigo/mcp into an application"
    }
  }
}
