{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    // ES2024 lib for `Promise.withResolvers` (the workspace's deferred-promise
    // idiom — see @ndigo/util's timing helpers). DOM libs are listed explicitly
    // because supplying `lib` replaces the target's defaults.
    "lib": ["ES2024", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*"]
}
