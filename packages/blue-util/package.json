{
  "name": "@blue/util",
  "version": "0.0.1",
  "description": "Blue Utility",
  "type": "module",
  "files": [
    "doc",
    "lib"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./date": "./lib/date/index.js",
    "./math": "./lib/math/index.js",
    "./string": "./lib/string/index.js",
    "./types": "./lib/type/index.js"
  },
  "types": "lib/index.d.ts",
  "typesVersions": {
    "*": {
      "date": [
        "./lib/date/index.d.ts"
      ],
      "math": [
        "./lib/math/index.d.ts"
      ],
      "string": [
        "./lib/string/index.d.ts"
      ],
      "types": [
        "./lib/type/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build:lib": "tsc -b tsconfig.build.json",
    "test": "vitest run",
    "api-report": "api-extractor run --local --verbose"
  },
  "repository": {
    "type": "git",
    "url": "https://bitbucketdc-digital.jpmchase.net/scm/bluejs/blue.git"
  },
  "keywords": [
    "blue",
    "bluejs",
    "blue-js",
    "blue-util",
    "util",
    "utilities",
    "utility"
  ],
  "author": "Jeff Rose <jeff_rose@outlook.com>",
  "license": "ISC",
  "dependencies": {
    "seedrandom": "~3.0.5",
    "slug": "~11.0.1"
  },
  "devDependencies": {
    "@types/seedrandom": "~3.0.8",
    "@types/slug": "~5.0.9"
  },
  "sideEffects": false
}