<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
    <meta charset="utf-8" />
    <title><%= await t('app.title') %></title>
    <!-- The adopted library's theme (design tokens) is a build input of the
         client bundle; the static controller serves the built asset. -->
    <link rel="stylesheet" href="/static/client.css" />
    <style>
        body { font-family: system-ui, sans-serif; max-width: 40rem; margin: 3rem auto; padding: 0 1rem; }
        todo-app { display: block; border: 1px solid var(--wa-color-surface-border, #ddd); border-radius: 8px; padding: 1rem; }
        /* AD-71 D-4: theming is CSS custom properties — token overrides at the
           document level inherit into the island's shadow root, no
           shadow-piercing hacks. */
        :root {
            --wa-color-brand-fill-loud: #1f7a5a;
            --wa-form-control-border-radius: 0.5rem;
        }
    </style>
</head>
<body>
    <h1><%= await t('app.title') %></h1>
    <p><%- await t('app.intro') %></p>
    <p><%= await t('app.today', { values: { date: formatDate(today, { dateStyle: 'long', timeZone: 'UTC' }) } }) %></p>
    <p><%= await t('app.mode.switched', { values: { language: locale.toUpperCase() } }) %></p>
    <!-- Island markup is rendered server-side by `IslandView` (with a
         declarative shadow root for first paint) and interpolated raw. The
         renderer runs now so it sees the request's negotiated language. -->
    <%- await renderIslandHtml() %>
    <script type="module" src="/static/client.js"></script>
</body>
</html>