{
  "$schema": "https://json-schema.org/schema",
  "id": "NdigoComponent",
  "title": "Create a Ndigo Component",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Component name in kebab-case (e.g., 'my-service')",
      "x-prompt": "What is the component name?"
    },
    "package": {
      "type": "string",
      "description": "Target package name without 'ndigo-' prefix (e.g., 'core')",
      "x-prompt": "Which @ndigo/* package?"
    },
    "className": {
      "type": "string",
      "description": "Override the PascalCase class name (defaults to PascalCase of name)"
    },
    "summary": {
      "type": "string",
      "description": "One-line summary used as the doc header description",
      "default": ""
    }
  },
  "required": ["name", "package"]
}
