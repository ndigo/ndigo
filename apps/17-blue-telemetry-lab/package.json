{
  "name": "@blue/telemetry-lab",
  "version": "0.0.1",
  "description": "Blue Telemetry Lab — browser action → server span → scheduled task → socket push, exported to console or an OTLP collector",
  "type": "module",
  "private": true,
  "scripts": {
    "build:client": "vite build",
    "start": "tsx src/index.ts",
    "dev": "npm run start:full",
    "start:full": "npm run build:client && tsx src/index.ts",
    "test": "vitest run"
  },
  "author": "Jeff Rose <jeff_rose@outlook.com>",
  "license": "ISC",
  "dependencies": {
    "@blue/boot": "~0.0.1",
    "@blue/context": "~0.0.1",
    "@blue/dispatcher": "~0.0.1",
    "@blue/factory": "~0.0.1",
    "@blue/http": "~0.0.1",
    "@blue/management": "~0.0.1",
    "@blue/platform-node": "~0.0.1",
    "@blue/scheduler": "~0.0.1",
    "@blue/socket": "~0.0.1",
    "@blue/telemetry": "~0.0.1",
    "@blue/telemetry-node": "~0.0.1",
    "@blue/telemetry-web": "~0.0.1",
    "@blue/util": "~0.0.1",
    "@opentelemetry/api": "catalog:",
    "@tsmetadata/polyfill": "catalog:",
    "zod": "catalog:",
    "@blue/log": "~0.0.1"
  },
  "devDependencies": {
    "@blue/test": "~0.0.1",
    "@opentelemetry/context-async-hooks": "catalog:",
    "@opentelemetry/core": "catalog:",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "tsx": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@blue/log": "~0.0.1"
  }
}
