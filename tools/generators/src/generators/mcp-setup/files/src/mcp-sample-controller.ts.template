import { getMapping, parameters, queryValue, toolMapping } from '@ndigo/dispatcher';

/**
 * Sample MCP tool generated by `ndigo add @ndigo/mcp`.
 *
 * The method is both a REST route and an MCP tool; its tool input schema is
 * projected from the same `@parameters` metadata.
 */
export class McpSampleController {
    @getMapping('/mcp/sample')
    @parameters({ message: queryValue('message') })
    @toolMapping({ name: 'sample_echo', readOnly: true, description: 'Echo a message.' })
    echo({ message }: { message: string }): { message: string } {
        return { message };
    }
}
