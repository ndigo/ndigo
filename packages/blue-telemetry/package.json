{
  "name": "@blue/telemetry",
  "version": "0.0.1",
  "description": "Blue Telemetry",
  "type": "module",
  "files": [
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./browser": {
      "types": "./lib/browser-config.d.ts",
      "default": "./lib/browser-config.js"
    },
    "./node": {
      "types": "./lib/node.d.ts",
      "default": "./lib/node.js"
    },
    "./web": {
      "types": "./lib/web.d.ts",
      "default": "./lib/web.js"
    }
  },
  "types": "lib/index.d.ts",
  "scripts": {
    "build:lib": "tsc -b tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "api-report": "api-extractor run --local --verbose"
  },
  "repository": {
    "type": "git",
    "url": "https://bitbucketdc-digital.jpmchase.net/scm/bluejs/blue.git"
  },
  "keywords": [
    "blue",
    "bluejs",
    "blue-js",
    "blue-telemetry",
    "observability",
    "opentelemetry",
    "metrics",
    "tracing"
  ],
  "author": "Jeff Rose <jeff_rose@outlook.com>",
  "license": "ISC",
  "dependencies": {
    "@opentelemetry/api": "~1.9.0",
    "@opentelemetry/api-logs": "~0.222.0",
    "@opentelemetry/exporter-logs-otlp-http": "~0.222.0",
    "@opentelemetry/exporter-metrics-otlp-http": "~0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "~0.222.0",
    "@opentelemetry/instrumentation": "~0.222.0",
    "@opentelemetry/resources": "~2.11.0",
    "@opentelemetry/sdk-logs": "~0.222.0",
    "@opentelemetry/sdk-metrics": "~2.11.0",
    "@opentelemetry/sdk-node": "~0.222.0",
    "@opentelemetry/sdk-trace-base": "~2.11.0",
    "@opentelemetry/semantic-conventions": "~1.25.1"
  },
  "devDependencies": {
    "@blue/context": "~0.0.1",
    "@blue/core": "~0.0.1",
    "@blue/dispatcher": "~0.0.1",
    "@blue/platform-node": "~0.0.1",
    "@blue/platform-web": "~0.0.1",
    "@blue/router": "~0.0.1",
    "@opentelemetry/context-async-hooks": "~2.11.0"
  },
  "peerDependencies": {
    "@blue/context": "~0.0.1",
    "@blue/core": "~0.0.1",
    "@blue/dispatcher": "~0.0.1",
    "@blue/platform-node": "~0.0.1",
    "@blue/platform-web": "~0.0.1",
    "@blue/router": "~0.0.1"
  }
}
