{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    // ES2024 lib for `Promise.withResolvers`; DOM libs are listed explicitly
    // because supplying `lib` replaces the target's defaults (the client half
    // of this app is a browser Web Component).
    "lib": ["ES2024", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*"]
}
