{
  "name": "@blue/telemetry",
  "version": "0.0.1",
  "description": "Isomorphic telemetry core for BlueJS \u2014 API-only: logger, metrics, severity, tracing decorators",
  "type": "module",
  "files": [
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "types": "lib/index.d.ts",
  "scripts": {
    "build:lib": "tsc -b tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "api-report": "api-extractor run --local --verbose"
  },
  "repository": {
    "type": "git",
    "url": "https://bitbucketdc-digital.jpmchase.net/scm/bluejs/blue.git"
  },
  "keywords": [
    "blue",
    "bluejs",
    "blue-js",
    "blue-telemetry",
    "observability",
    "opentelemetry",
    "metrics",
    "tracing"
  ],
  "author": "Jeff Rose <jeff_rose@outlook.com>",
  "license": "ISC",
  "dependencies": {
    "@opentelemetry/api": "~1.9.0",
    "@opentelemetry/api-logs": "~0.222.0",
    "@opentelemetry/instrumentation": "~0.222.0"
  },
  "devDependencies": {
    "@blue/context": "~0.0.1",
    "@blue/core": "~0.0.1",
    "@blue/dispatcher": "~0.0.1",
    "@blue/router": "~0.0.1",
    "@blue/telemetry-node": "workspace:~"
  }
}
