{
  "$schema": "https://typedoc.org/schema.json",
  "name": "BlueJS Framework",
  "entryPointStrategy": "resolve",
  "entryPoints": [
    "packages/blue-core/src/index.ts",
    "packages/blue-util/src/index.ts",
    "packages/blue-context/src/index.ts",
    "packages/blue-router/src/index.ts",
    "packages/blue-view/src/index.ts",
    "packages/blue-http/src/index.ts",
    "packages/blue-model/src/index.ts",
    "packages/blue-content/src/index.ts",
    "packages/blue-domain/src/index.ts",
    "packages/blue-validate/src/index.ts",
    "packages/blue-boot/src/index.ts",
    "packages/blue-service/src/index.ts",
    "packages/blue-dispatcher/src/index.ts",
    "packages/blue-view-webcomponent/src/index.ts",
    "packages/blue-platform-web/src/index.ts",
    "packages/blue-factory/src/index.ts",
    "packages/blue-auth/src/index.ts",
    "packages/blue-dom/src/index.ts",
    "packages/blue-eslint-plugin/src/index.ts",
    "packages/blue-generators/src/index.ts",
    "packages/blue-orm/src/index.ts",
    "packages/blue-orm-drizzle/src/index.ts",
    "packages/blue-platform-node/src/index.ts",
    "packages/blue-signals/src/index.ts",
    "packages/blue-telemetry/src/index.ts",
    "packages/blue-telemetry-node/src/index.ts",
    "packages/blue-telemetry-web/src/index.ts"
  ],
  "exclude": ["**/node_modules/**", "**/test/**", "archive/**"],
  "out": "doc-html",
  "readme": "README.md",
  "categorizeByGroup": true,
  "categoryOrder": ["Function", "List", "Object", "String", "Type", "Logic", "Math", "Relation", "*"],
  "excludePrivate": true,
  "excludeProtected": false,
  "excludeInternal": false,
  "includeVersion": true,
  "sort": ["source-order"],
  "gitRevision": "main",
  "skipErrorChecking": true,
  "treatWarningsAsErrors": false,
  "treatValidationWarningsAsErrors": false,
  "compilerOptions": {
    "skipLibCheck": true,
    "noEmit": true
  }
}
