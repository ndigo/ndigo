/**
 */
import { routeMapping, ModelAndView } from '@ndigo/dispatcher';
import { WebComponentView } from '@ndigo/view-webcomponent';

@routeMapping('/')
class <%= className %>Controller {
    @routeMapping('/')
    handleRoot() {
        // The minimal example returns a realized view; placement stays on the
        // preset's `#app` target and no chains run. Return a view NAME to let
        // the resolver chain pick the view; configure `viewTargeters` for
        // named regions and layouts (docs/guides/50-view-targeting.md).
        return new ModelAndView(new WebComponentView('<%= name %>-app'), { message: 'Hello, World!' });
    }
}

export default <%= className %>Controller;
