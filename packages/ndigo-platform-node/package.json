{
  "name": "@ndigo/platform-node",
  "version": "0.0.1",
  "description": "Node.js platform adapter for Ndigo — HTTP server, auto-configuration, static files, multipart",
  "type": "module",
  "files": [
    "api",
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./node-auto-configuration": {
      "types": "./lib/node-auto-configuration.d.ts",
      "default": "./lib/node-auto-configuration.js"
    }
  },
  "types": "lib/index.d.ts",
  "scripts": {
    "build:lib": "tsc -b tsconfig.build.json",
    "test": "vitest run"
  },
  "keywords": [
    "ndigo",
    "ndigo",
    "ndigo-js",
    "ndigo-platform",
    "ndigo-platform-node",
    "platform",
    "node"
  ],
  "author": "Jeff Rose <jeff_rose@outlook.com>",
  "license": "ISC",
  "devDependencies": {
    "@types/busboy": "^1.5.5",
    "@types/ws": "catalog:",
    "zod": "catalog:"
  },
  "sideEffects": false,
  "dependencies": {
    "@ndigo/auth-core": "~0.0.1",
    "@ndigo/cache": "~0.0.1",
    "@ndigo/context": "~0.0.1",
    "@ndigo/core": "~0.0.1",
    "@ndigo/dispatcher": "~0.0.1",
    "@ndigo/factory": "~0.0.1",
    "@ndigo/flags": "~0.0.1",
    "@ndigo/http": "~0.0.1",
    "@ndigo/jobs": "~0.0.1",
    "@ndigo/locks": "~0.0.1",
    "@ndigo/log": "~0.0.1",
    "@ndigo/openapi": "~0.0.1",
    "@ndigo/rate-limit": "~0.0.1",
    "@ndigo/router": "~0.0.1",
    "@ndigo/scheduler": "~0.0.1",
    "@ndigo/socket": "~0.0.1",
    "@ndigo/util": "~0.0.1",
    "@ndigo/view": "~0.0.1",
    "@tsmetadata/polyfill": "catalog:",
    "busboy": "^1.6.0",
    "helmet": "^8.3.0",
    "ws": "catalog:"
  },
  "peerDependencies": {
    "swagger-ui-dist": "5.34.1"
  }
}
